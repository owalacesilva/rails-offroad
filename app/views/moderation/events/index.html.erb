<% content_for :title, "#{t('admin.events.index.title')} — #{t('admin.title')}" %>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("admin.events.index.title") %></h1>
      <p class="mt-1 text-sm text-stone-500"><%= t("admin.events.index.subtitle") %></p>
    </div>

    <%= link_to t("admin.events.index.new"), new_admin_event_path,
          class: "rounded-full bg-brand-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
  </div>

  <%# Duas abas: o que ainda vai acontecer (o que a home mostra) e o histórico. %>
  <nav class="mt-6 flex flex-wrap gap-2" aria-label="<%= t("admin.events.index.filter_label") %>">
    <% Moderation::EventsController::SCOPES.each do |scope| %>
      <% current = scope == @scope %>
      <%= link_to admin_events_path(scope: scope),
            "aria-current": current ? "page" : nil,
            class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{current ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
        <%= t("admin.events.scopes.#{scope}") %>
        <span class="rounded-full <%= current ? "bg-white/20" : "bg-stone-100" %> px-1.5 py-0.5 text-[10px]">
          <%= @counts.fetch(scope, 0) %>
        </span>
      <% end %>
    <% end %>
  </nav>

  <% if @events.any? %>
    <div class="mt-6 space-y-3">
      <% @events.each do |event| %>
        <article class="flex flex-wrap items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-brand-500/15 text-brand-700">
            <span class="text-lg font-extrabold leading-none"><%= l(event.starts_on, format: :event_card_day) %></span>
            <span class="mt-0.5 text-[10px] font-bold uppercase tracking-wide"><%= l(event.starts_on, format: :event_card_month) %></span>
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="text-sm font-bold text-stone-900"><%= event.title %></h2>
            <p class="mt-1 text-xs font-semibold text-brand-600"><%= event_dates(event) %></p>
            <p class="mt-1 text-xs text-stone-500">
              <%= [ event.venue, event.location ].compact_blank.join(" · ") %>
            </p>

            <% if event.external_url.present? %>
              <p class="mt-1 truncate text-xs text-stone-400">
                <%= link_to event.external_url, event.external_url, target: "_blank", rel: "noopener nofollow",
                      class: "transition hover:text-brand-600" %>
              </p>
            <% end %>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <%= link_to t("admin.events.index.edit"), edit_admin_event_path(event, scope: @scope),
                  class: "rounded-full border border-stone-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-stone-900 hover:text-stone-900" %>

            <%# turbo_confirm porque apagar não tem volta e não há lixeira. %>
            <%= button_to t("admin.events.index.destroy"), admin_event_path(event), method: :delete,
                  form: { data: { turbo_confirm: t("admin.events.index.destroy_confirm", title: event.title) } },
                  class: "cursor-pointer rounded-full border border-red-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-red-600 transition hover:bg-red-600 hover:text-white" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-stone-800"><%= t("admin.events.index.empty.#{@scope}.title") %></h2>
      <p class="mt-2 text-sm text-stone-500"><%= t("admin.events.index.empty.#{@scope}.subtitle") %></p>
    </div>
  <% end %>
</section>
