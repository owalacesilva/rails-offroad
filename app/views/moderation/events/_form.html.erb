<%# Formulário de evento, compartilhado entre novo e edição. %>
<% field_class = "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
<% label_class = "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>

<%= form_with model: [ :admin, event ], class: "space-y-6" do |form| %>
  <% if event.errors.any? %>
    <div role="alert" class="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-bold"><%= t("admin.events.form.errors", count: event.errors.count) %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: label_class %>
    <%= form.text_field :title, required: true, autofocus: true,
          placeholder: t("admin.events.form.title_placeholder"), class: field_class %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :starts_on, class: label_class %>
      <%= form.date_field :starts_on, required: true, class: field_class %>
    </div>

    <div>
      <%= form.label :ends_on, class: label_class %>
      <%= form.date_field :ends_on, class: field_class %>
      <p class="mt-1 text-xs text-stone-400"><%= t("admin.events.form.ends_on_hint") %></p>
    </div>
  </div>

  <%# Mesmo seletor do formulário de anúncio: os municípios chegam por UF, em
      vez de os 5.571 saírem no HTML. %>
  <div class="grid gap-5 sm:grid-cols-3">
    <div>
      <%= form.label :state, class: label_class %>
      <%= form.select :state, User::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
            class: field_class, data: { city_select_state: true } %>
    </div>

    <div class="sm:col-span-2">
      <%= render "shared/city_select", name: form.field_name(:city), value: form.object.city,
            label: Event.human_attribute_name(:city), required: true,
            label_class: label_class, field_class: field_class %>
    </div>
  </div>

  <div>
    <%= form.label :venue, class: label_class %>
    <%= form.text_field :venue, placeholder: t("admin.events.form.venue_placeholder"), class: field_class %>
  </div>

  <div>
    <%= form.label :description, class: label_class %>
    <%= form.text_area :description, rows: 4,
          placeholder: t("admin.events.form.description_placeholder"), class: field_class %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= render "shared/url_field", form: form, field: :url,
            placeholder: "exemplo.com.br/evento", label_class: label_class, field_class: field_class %>
      <p class="mt-1 text-xs text-stone-400"><%= t("admin.events.form.url_hint") %></p>
    </div>

    <div>
      <%= form.label :featured, class: label_class %>
      <label class="mt-2 flex cursor-pointer items-start gap-2 rounded-lg border border-stone-300 bg-white px-3 py-2.5">
        <%= form.check_box :featured, class: "mt-0.5 size-4 cursor-pointer accent-brand-500" %>
        <span class="text-xs leading-relaxed text-stone-600"><%= t("admin.events.form.featured_hint") %></span>
      </label>
    </div>
  </div>

  <%= render "shared/cover_field", form: form, url_field: :image_url,
        current: event.cover_url, label_class: label_class, field_class: field_class %>

  <div class="flex flex-wrap items-center gap-3 border-t border-stone-200 pt-5">
    <%= form.submit submit_label,
          class: "cursor-pointer rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
    <%= link_to t("admin.events.form.cancel"), admin_events_path,
          class: "text-xs font-bold uppercase tracking-wide text-stone-400 transition hover:text-stone-900" %>
  </div>
<% end %>
