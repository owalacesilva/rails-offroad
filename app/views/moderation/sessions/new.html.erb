<% content_for :title, "#{t('admin.sessions.new.title')} — #{t('admin.title')}" %>

<section class="mx-auto max-w-md px-4 py-16 sm:px-6 lg:py-24">
  <div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-extrabold tracking-tight text-stone-900"><%= t("admin.sessions.new.title") %></h1>
    <p class="mt-2 text-sm text-stone-500"><%= t("admin.sessions.new.subtitle") %></p>

    <%= form_with url: admin_login_path, method: :post, class: "mt-8 space-y-4" do %>
      <div>
        <%= label_tag :email, Admin.human_attribute_name(:email), class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= email_field_tag :email, params[:email], required: true, autofocus: true, autocomplete: "email",
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      </div>

      <div>
        <%= label_tag :password, Admin.human_attribute_name(:password), class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= password_field_tag :password, nil, required: true, autocomplete: "current-password",
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      </div>

      <%= submit_tag t("admin.sessions.new.submit"),
            class: "w-full cursor-pointer rounded-full bg-stone-900 px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-stone-700" %>
    <% end %>
  </div>
</section>
