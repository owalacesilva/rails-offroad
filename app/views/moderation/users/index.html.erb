<% content_for :title, "#{t('admin.users.index.title')} — #{t('admin.title')}" %>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("admin.users.index.title") %></h1>
  <p class="mt-1 text-sm text-stone-500"><%= t("admin.users.index.subtitle") %></p>

  <%# Abas por situação. Bloquear tira os anúncios do portal sem mexer em cada
      um deles (ver Ad.published), e é o que esta tela existe para fazer. %>
  <nav class="mt-6 flex flex-wrap gap-2" aria-label="<%= t("admin.users.index.filter_label") %>">
    <%= link_to admin_users_path(q: @query),
          "aria-current": @status.nil? ? "page" : nil,
          class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{@status.nil? ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
      <%= t("admin.users.index.all") %>
      <span class="rounded-full <%= @status.nil? ? "bg-white/20" : "bg-stone-100" %> px-1.5 py-0.5 text-[10px]"><%= @counts.values.sum %></span>
    <% end %>

    <% User::STATUSES.each_value do |status| %>
      <% current = status == @status %>
      <%= link_to admin_users_path(status: status, q: @query),
            "aria-current": current ? "page" : nil,
            class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{current ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
        <%= t("admin.users.statuses.#{status}") %>
        <span class="rounded-full <%= current ? "bg-white/20" : "bg-stone-100" %> px-1.5 py-0.5 text-[10px]"><%= @counts.fetch(status, 0) %></span>
      <% end %>
    <% end %>
  </nav>

  <%= form_with url: admin_users_path, method: :get, class: "mt-4 flex flex-wrap gap-2" do %>
    <%= hidden_field_tag :status, @status %>
    <%= label_tag :q, t("admin.users.index.search"), class: "sr-only" %>
    <%= search_field_tag :q, @query, placeholder: t("admin.users.index.search_placeholder"),
          class: "min-w-0 flex-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30 sm:max-w-sm" %>
    <button type="submit" class="cursor-pointer rounded-full bg-stone-900 px-5 py-2 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-stone-700">
      <%= t("admin.users.index.search") %>
    </button>
  <% end %>

  <% if @users.any? %>
    <div class="mt-6 space-y-3">
      <% @users.each do |user| %>
        <article class="flex flex-wrap items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-stone-100 text-lg font-extrabold text-stone-500">
            <%= user.name.first.upcase %>
          </span>

          <div class="min-w-0 flex-1">
            <h2 class="flex flex-wrap items-center gap-2 text-sm font-bold text-stone-900">
              <%= user.name %>
              <%= user_status_badge(user) %>
            </h2>
            <p class="mt-1 text-xs text-stone-500">
              <%= mail_to user.email, user.email, class: "transition hover:text-brand-600" %>
              &middot; <%= user.location %>
              &middot; <%= t("admin.users.index.member_since", date: l(user.member_since, format: :long)) %>
            </p>
            <p class="mt-2 flex flex-wrap gap-3 text-xs text-stone-500">
              <span><%= t("admin.users.index.ads", count: user.ads.size) %></span>
              <span><%= t("admin.users.index.published", count: user.ads.count { |ad| ad.status == "approved" }) %></span>
            </p>
          </div>

          <%# Só as transições que fazem sentido a partir da situação atual. %>
          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <% User::STATUSES.each_value do |status| %>
              <% next if status == user.status %>
              <%= button_to t("admin.users.actions.#{status}"), status_admin_user_path(user, to: status), method: :patch,
                    form: { data: { turbo_confirm: t("admin.users.actions.confirm.#{status}", name: user.name) } },
                    class: "cursor-pointer rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{status == 'blocked' ? 'border-red-300 text-red-600 hover:bg-red-600 hover:text-white' : 'border-stone-300 text-stone-600 hover:border-stone-900 hover:text-stone-900'}" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-stone-800"><%= t("admin.users.index.empty.title") %></h2>
      <p class="mt-2 text-sm text-stone-500"><%= t("admin.users.index.empty.subtitle") %></p>
    </div>
  <% end %>
</section>
