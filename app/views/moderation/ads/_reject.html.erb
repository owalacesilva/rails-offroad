<%# Rejeição com recado. O motivo é obrigatório: rejeitar em silêncio deixa o
    anunciante sem saber o que corrigir, e é ele que aparece no painel dele. %>
<dialog data-modal-target="dialog"
        data-action="click->modal#closeOnBackdrop"
        aria-labelledby="reject-<%= ad.id %>-title"
        class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-stone-300 bg-white p-0 text-stone-900 backdrop:bg-stone-950/80 backdrop:backdrop-blur-sm">
  <div class="border-b border-stone-200 p-6">
    <h2 id="reject-<%= ad.id %>-title" class="text-lg font-bold text-stone-900">
      <%= t("admin.ads.reject_modal.title") %>
    </h2>
    <p class="mt-1 truncate text-sm text-stone-500"><%= ad.title %></p>
  </div>

  <%= form_with url: reject_admin_ad_path(ad), method: :patch, class: "space-y-4 p-6" do %>
    <div>
      <%= label_tag "note_#{ad.id}", t("admin.ads.reject_modal.note"),
            class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
      <%= text_area_tag :note, nil, id: "note_#{ad.id}", rows: 4, required: true,
            placeholder: t("admin.ads.reject_modal.placeholder"),
            class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      <p class="mt-1 text-xs text-stone-400"><%= t("admin.ads.reject_modal.hint") %></p>
    </div>

    <div class="flex flex-wrap items-center justify-end gap-3 border-t border-stone-200 pt-5">
      <button type="button" data-action="modal#close"
              class="cursor-pointer rounded-full px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-500 transition hover:text-stone-700">
        <%= t("admin.ads.reject_modal.cancel") %>
      </button>

      <button type="submit"
              class="cursor-pointer rounded-full bg-red-600 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-red-500">
        <%= t("admin.ads.reject_modal.submit") %>
      </button>
    </div>
  <% end %>
</dialog>
