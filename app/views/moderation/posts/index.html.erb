<% content_for :title, "#{t('admin.posts.index.title')} — #{t('admin.title')}" %>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("admin.posts.index.title") %></h1>
      <p class="mt-1 text-sm text-stone-500"><%= t("admin.posts.index.subtitle") %></p>
    </div>

    <%= link_to t("admin.posts.index.new"), new_admin_post_path,
          class: "rounded-full bg-brand-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
  </div>

  <%# Três listas, e nenhuma coluna de status: quem as separa é published_at. %>
  <nav class="mt-6 flex flex-wrap gap-2" aria-label="<%= t("admin.posts.index.filter_label") %>">
    <% Moderation::PostsController::SCOPES.each do |scope| %>
      <% current = scope == @scope %>
      <%= link_to admin_posts_path(scope: scope),
            "aria-current": current ? "page" : nil,
            class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{current ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
        <%= t("admin.posts.scopes.#{scope}") %>
        <span class="rounded-full <%= current ? "bg-white/20" : "bg-stone-100" %> px-1.5 py-0.5 text-[10px]">
          <%= @counts.fetch(scope, 0) %>
        </span>
      <% end %>
    <% end %>
  </nav>

  <% if @posts.any? %>
    <div class="mt-6 space-y-3">
      <% @posts.each do |post| %>
        <article class="flex flex-wrap items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <% cover = post.cover %>
          <div class="h-16 w-24 shrink-0 overflow-hidden rounded-lg bg-stone-100">
            <% if cover.present? %>
              <%= image_tag cover, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center text-stone-300">
                <%= home_section_icon(:document, css_class: "h-6 w-6") %>
              </div>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="text-sm font-bold text-stone-900"><%= post.title %></h2>
            <p class="mt-1 text-xs text-stone-500">
              <%= t("posts.by", name: post.admin.name) %>
              <% if post.published_at.present? %>
                &middot; <%= l(post.published_at, format: :long) %>
              <% end %>
            </p>
            <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-stone-500"><%= post.summary %></p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <% if post.published? %>
              <%= link_to t("admin.posts.index.view"), post_path(post), target: "_blank", rel: "noopener",
                    class: "rounded-full border border-stone-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-stone-900 hover:text-stone-900" %>
            <% end %>

            <%= link_to t("admin.posts.index.edit"), edit_admin_post_path(post, scope: @scope),
                  class: "rounded-full border border-stone-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-stone-900 hover:text-stone-900" %>

            <%# turbo_confirm porque apagar não tem volta e não há lixeira. %>
            <%= button_to t("admin.posts.index.destroy"), admin_post_path(post), method: :delete,
                  form: { data: { turbo_confirm: t("admin.posts.index.destroy_confirm", title: post.title) } },
                  class: "cursor-pointer rounded-full border border-red-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-red-600 transition hover:bg-red-600 hover:text-white" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
      <h2 class="text-lg font-bold text-stone-800"><%= t("admin.posts.index.empty.#{@scope}.title") %></h2>
      <p class="mt-2 text-sm text-stone-500"><%= t("admin.posts.index.empty.#{@scope}.subtitle") %></p>
    </div>
  <% end %>
</section>
