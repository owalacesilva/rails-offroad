<h1><%= t(".greeting", name: @user.name) %></h1>

<%# Chave _html: o I18n marca a tradução como segura e escapa as interpolações
    que não forem html_safe — o link_to já é. %>
<p><%= t(".intro_html", title: link_to(@ad.title, ad_url(@ad))) %></p>

<table cellpadding="6" cellspacing="0" border="0">
  <tr>
    <td><strong><%= Proposal.human_attribute_name(:offered_value) %></strong></td>
    <td><%= ad_price(@proposal.offered_value) %></td>
  </tr>
  <tr>
    <td><strong><%= Proposal.human_attribute_name(:name) %></strong></td>
    <td><%= @proposal.name %></td>
  </tr>
  <tr>
    <td><strong><%= Proposal.human_attribute_name(:email) %></strong></td>
    <td><%= mail_to @proposal.email %></td>
  </tr>
  <% if @proposal.phone.present? %>
    <tr>
      <td><strong><%= Proposal.human_attribute_name(:phone) %></strong></td>
      <td><%= @proposal.phone %></td>
    </tr>
  <% end %>
</table>

<% if @proposal.message.present? %>
  <p><strong><%= Proposal.human_attribute_name(:message) %></strong></p>
  <blockquote><%= simple_format @proposal.message %></blockquote>
<% end %>

<p><%= t(".footer") %></p>
