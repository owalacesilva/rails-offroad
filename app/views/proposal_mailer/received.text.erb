<%= t(".greeting", name: @user.name) %>

<%= t(".intro", title: @ad.title) %>
<%= ad_url(@ad) %>

<%= Proposal.human_attribute_name(:offered_value) %>: <%= ad_price(@proposal.offered_value) %>
<%= Proposal.human_attribute_name(:name) %>: <%= @proposal.name %>
<%= Proposal.human_attribute_name(:email) %>: <%= @proposal.email %>
<% if @proposal.phone.present? -%>
<%= Proposal.human_attribute_name(:phone) %>: <%= @proposal.phone %>
<% end -%>
<% if @proposal.message.present? -%>

<%= Proposal.human_attribute_name(:message) %>:
<%= @proposal.message %>
<% end -%>

<%= t(".footer") %>
