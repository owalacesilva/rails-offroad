<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "#{t('dashboard.breadcrumb_account')} — OffRoad Classificados" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# O layout é dono do chrome, do container e da grade; a view entrega só a
      coluna principal. %>
  <body class="flex min-h-screen flex-col bg-stone-100 text-stone-900 antialiased">
    <%= render "shared/account_header" %>

    <main class="flex-1">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold text-stone-500" aria-label="Breadcrumb">
          <%= link_to t("dashboard.breadcrumb_home"), root_path, class: "transition hover:text-brand-600" %>
          <span aria-hidden="true">&rsaquo;</span>
          <% if content_for?(:breadcrumb) %>
            <%= link_to t("dashboard.breadcrumb_account"), account_path, class: "transition hover:text-brand-600" %>
            <span aria-hidden="true">&rsaquo;</span>
            <span class="text-brand-600"><%= yield :breadcrumb %></span>
          <% else %>
            <span class="text-brand-600"><%= t("dashboard.breadcrumb_account") %></span>
          <% end %>
        </nav>

        <% if flash.any? %>
          <div class="mt-6 space-y-3">
            <% flash.each do |type, message| %>
              <div role="status"
                   class="rounded-xl border px-5 py-4 text-sm font-semibold <%= type.to_s == "alert" ? "border-red-300 bg-red-50 text-red-700" : "border-emerald-300 bg-emerald-50 text-emerald-700" %>">
                <%= message %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="mt-6 grid gap-6 lg:grid-cols-12">
          <%= render "shared/account_sidebar", active: account_section %>

          <div class="lg:col-span-9"><%= yield %></div>
        </div>
      </div>
    </main>

    <%= render "shared/account_footer" %>
  </body>
</html>
