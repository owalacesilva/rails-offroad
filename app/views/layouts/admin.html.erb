<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || t("admin.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-100 text-stone-900 antialiased">
    <header class="border-b-2 border-stone-900 bg-white">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
        <%= link_to admin_root_path, class: "flex items-center gap-2.5" do %>
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-stone-900 text-xs font-extrabold text-brand-400">
            OR
          </span>
          <span class="text-sm font-extrabold uppercase tracking-tight">
            <%= t("admin.title") %>
          </span>
        <% end %>

        <% if admin_authenticated? %>
          <nav class="flex items-center gap-4 text-sm font-semibold text-stone-600">
            <%= link_to t("admin.nav.queue"), admin_ads_path, class: "transition hover:text-brand-600" %>
          </nav>

          <div class="ml-auto flex items-center gap-3">
            <span class="hidden text-sm font-semibold text-stone-500 sm:inline"><%= current_admin.name %></span>
            <%= button_to t("admin.nav.sign_out"), admin_logout_path, method: :delete,
                  class: "cursor-pointer rounded-full border border-stone-300 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-stone-900 hover:text-stone-900" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="flex-1">
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
          <% flash.each do |type, message| %>
            <div role="status"
                 class="rounded-xl border px-5 py-4 text-sm font-semibold <%= type.to_s == "alert" ? "border-red-300 bg-red-50 text-red-700" : "border-emerald-300 bg-emerald-50 text-emerald-700" %>">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
