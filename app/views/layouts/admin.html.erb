<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("admin.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-100 text-stone-900 antialiased">
    <header class="border-b-2 border-stone-900 bg-white">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
        <%# O emblema identifica o portal; o rótulo ao lado diz em que área você
            está, que é o que distingue a moderação do resto. %>
        <%= link_to admin_root_path, class: "flex shrink-0 items-center gap-2.5" do %>
          <%= image_tag "logo.png", alt: t("layout.header.brand"), width: 248, height: 252,
                class: "h-11 w-auto" %>
          <span class="text-sm font-extrabold uppercase tracking-tight">
            <%= t("admin.title") %>
          </span>
        <% end %>

        <% if admin_authenticated? %>
          <nav class="hidden items-center gap-4 text-sm font-semibold text-stone-600 sm:flex">
            <%= link_to t("admin.nav.queue"), admin_ads_path, class: "transition hover:text-brand-600" %>
            <%= link_to t("admin.nav.events"), admin_events_path, class: "transition hover:text-brand-600" %>
            <%= link_to t("admin.nav.posts"), admin_posts_path, class: "transition hover:text-brand-600" %>
            <%= link_to t("admin.nav.users"), admin_users_path, class: "transition hover:text-brand-600" %>
          </nav>

          <div class="ml-auto flex items-center gap-3">
            <%# Uma fila por situação é o que a moderação de fato faz; o menu leva
                direto a cada uma sem passar pela aba da página. %>
            <%= render layout: "shared/dropdown", locals: { label: current_admin.name } do %>
              <% Ad::STATUSES.each_value do |status| %>
                <%= link_to t("admin.ads.statuses.#{status}"), admin_ads_path(status: status),
                      class: dropdown_item_class %>
              <% end %>

              <%= link_to t("admin.nav.events"), admin_events_path, class: separated_dropdown_item_class %>
              <%= link_to t("admin.nav.posts"), admin_posts_path, class: dropdown_item_class %>
              <%= link_to t("admin.nav.users"), admin_users_path, class: dropdown_item_class %>

              <%= link_to t("layout.account.back_to_portal"), root_path,
                    class: dropdown_item_class %>

              <%= render "shared/locale_menu_items" %>

              <%= button_to t("admin.nav.sign_out"), admin_logout_path, method: :delete,
                    class: "#{separated_dropdown_item_class} cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="flex-1">
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
          <% flash.each do |type, message| %>
            <div role="status"
                 class="rounded-xl border px-5 py-4 text-sm font-semibold <%= type.to_s == "alert" ? "border-red-300 bg-red-50 text-red-700" : "border-emerald-300 bg-emerald-50 text-emerald-700" %>">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
