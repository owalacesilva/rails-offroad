<%# Footer global. Claro, como o resto do portal.

    Os endereços das redes vêm do ambiente (lib/social_links.rb): rede sem
    variável definida some da faixa em vez de virar um link para "#". %>
<footer class="border-t border-stone-200 bg-stone-100">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <%# Mesmo lockup do header: emblema mais o nome por extenso. %>
          <%= image_tag "logo.png", alt: "", width: 248, height: 252, loading: "lazy",
                class: "h-11 w-auto" %>
          <span class="text-base font-extrabold uppercase leading-none tracking-tight text-stone-900">
            OffRoad<span class="text-brand-600"> Classificados</span>
          </span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-600">
          <%= t("layout.footer.tagline") %>
        </p>

        <% networks = social_links %>
        <% if networks.any? %>
          <ul class="mt-5 flex items-center gap-3">
            <% networks.each do |network| %>
              <li>
                <%= link_to network.url, rel: "noopener me", target: "_blank",
                      "aria-label": network.label,
                      class: "flex h-9 w-9 items-center justify-center rounded-full border border-stone-300 bg-white text-stone-500 transition hover:border-brand-500 hover:text-brand-600" do %>
                  <%= social_icon(network.key) %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-stone-900"><%= t("layout.footer.headings.categories") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-600">
          <%# Slugs literais de propósito: o footer está no layout e roda em toda página,
              inclusive nas de erro — não vale uma consulta ao banco por render. %>
          <% %w[veiculos-4x4 motos-quadriciclos utvs pecas-acessorios].each do |slug| %>
            <li>
              <%= link_to t("categories.#{slug}.name"), ads_path(category: slug),
                    class: "transition hover:text-brand-600" %>
            </li>
          <% end %>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-stone-900"><%= t("layout.footer.headings.institutional") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-600">
          <% institutional_links.each do |key, path| %>
            <li><%= link_to t("layout.footer.institutional.#{key}"), path, class: "transition hover:text-brand-600" %></li>
          <% end %>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-stone-900"><%= t("layout.footer.headings.contact") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-600">
          <li>
            <% email = t("layout.footer.contact.email") %>
            <%= link_to email, "mailto:#{email}", class: "transition hover:text-brand-600" %>
          </li>
          <li>
            <% phone = t("layout.footer.contact.phone") %>
            <%= link_to phone, tel_url(phone), class: "transition hover:text-brand-600" %>
          </li>
          <li><%= link_to t("layout.footer.contact.help_center"), how_to_advertise_path, class: "transition hover:text-brand-600" %></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-stone-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-stone-500">
        &copy; <%= Time.current.year %> OffRoad Classificados. <%= t("layout.footer.legal.rights") %>
      </p>
      <div class="flex gap-5 text-xs text-stone-500">
        <%= link_to t("layout.footer.legal.terms"), terms_of_use_path, class: "transition hover:text-brand-600" %>
        <%= link_to t("layout.footer.legal.privacy"), privacy_policy_path, class: "transition hover:text-brand-600" %>
      </div>
    </div>
  </div>
</footer>
