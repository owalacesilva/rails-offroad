<%# Footer global. Links fictícios até existirem as rotas reais. %>
<footer class="border-t border-stone-800 bg-stone-950">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-stone-950">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 17.25 8.25 9l3.75 5.25L15.75 6l5.25 11.25H3Z" />
            </svg>
          </span>
          <span class="text-base font-extrabold uppercase leading-none tracking-tight text-white">
            OffRoad<span class="text-brand-400"> Classificados</span>
          </span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-400">
          <%= t("layout.footer.tagline") %>
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a href="#" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-800 text-stone-400 transition hover:border-brand-500 hover:text-brand-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.8.22 2.43.47.66.25 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.63.42 1.36.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.8-.47 2.43-.25.66-.6 1.22-1.15 1.77-.55.55-1.11.9-1.77 1.15-.63.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.8-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.63-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.8.47-2.43.25-.66.6-1.22 1.15-1.77a4.9 4.9 0 0 1 1.77-1.15c.63-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.8 6.9a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Z" />
            </svg>
          </a>
          <a href="#" aria-label="YouTube" class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-800 text-stone-400 transition hover:border-brand-500 hover:text-brand-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.58 7.19a2.51 2.51 0 0 0-1.77-1.78C18.25 5 12 5 12 5s-6.25 0-7.81.41a2.51 2.51 0 0 0-1.77 1.78A26.2 26.2 0 0 0 2 12a26.2 26.2 0 0 0 .42 4.81 2.51 2.51 0 0 0 1.77 1.78C5.75 19 12 19 12 19s6.25 0 7.81-.41a2.51 2.51 0 0 0 1.77-1.78A26.2 26.2 0 0 0 22 12a26.2 26.2 0 0 0-.42-4.81ZM10 15V9l5.2 3-5.2 3Z" />
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-800 text-stone-400 transition hover:border-brand-500 hover:text-brand-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
            </svg>
          </a>
          <a href="#" aria-label="WhatsApp" class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-800 text-stone-400 transition hover:border-brand-500 hover:text-brand-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.09 3.2 5.07 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35ZM12.05 2C6.58 2 2.13 6.45 2.13 11.92c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.8 1.22h.01c5.46 0 9.91-4.45 9.91-9.92C21.97 6.45 17.52 2 12.05 2Z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white"><%= t("layout.footer.headings.categories") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-400">
          <%# Slugs literais de propósito: o footer está no layout e roda em toda página,
              inclusive nas de erro — não vale uma consulta ao banco por render. %>
          <% %w[veiculos-4x4 motos-quadriciclos utvs pecas-acessorios].each do |slug| %>
            <li>
              <%= link_to t("categories.#{slug}.name"), ads_path(category: slug),
                    class: "transition hover:text-brand-400" %>
            </li>
          <% end %>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white"><%= t("layout.footer.headings.institutional") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-400">
          <% %i[about how_to_advertise plans safety].each do |key| %>
            <li><a href="#" class="transition hover:text-brand-400"><%= t("layout.footer.institutional.#{key}") %></a></li>
          <% end %>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-white"><%= t("layout.footer.headings.contact") %></h3>
        <ul class="mt-4 space-y-2.5 text-sm text-stone-400">
          <% %i[email phone help_center careers].each do |key| %>
            <li><a href="#" class="transition hover:text-brand-400"><%= t("layout.footer.contact.#{key}") %></a></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-stone-800 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-stone-500">
        &copy; <%= Time.current.year %> OffRoad Classificados. <%= t("layout.footer.legal.rights") %>
      </p>
      <div class="flex gap-5 text-xs text-stone-500">
        <% %i[terms privacy cookies].each do |key| %>
          <a href="#" class="transition hover:text-brand-400"><%= t("layout.footer.legal.#{key}") %></a>
        <% end %>
      </div>
    </div>
  </div>
</footer>
