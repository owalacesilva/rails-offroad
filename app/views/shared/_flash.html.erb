<%# Feedback do servidor, em modal.

    O elemento com data-controller="flash" não desenha nada: só carrega as
    mensagens para o flash_controller, que abre o SweetAlert e remove o
    elemento em seguida — o Turbo fotografa a página ao sair dela para o cache,
    e sem a remoção o mesmo aviso reapareceria no "voltar" do navegador.

    O <noscript> repete o aviso em faixa, que era como o portal falava antes.
    Sem JavaScript não há modal, e ficar sem resposta nenhuma depois de salvar é
    pior do que uma faixa. O navegador com script ligado nem monta o conteúdo
    dele, então não há piscada de banner antes do modal. %>
<% if flash.any? %>
  <div hidden
       data-controller="flash"
       data-flash-messages-value="<%= flash.to_h.to_json %>"
       data-flash-confirm-value="<%= t("layout.flash.confirm") %>"></div>

  <noscript>
    <div class="<%= local_assigns.fetch(:wrapper, "mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8") %>">
      <% flash.each do |type, message| %>
        <div role="status"
             class="rounded-xl border px-5 py-4 text-sm font-semibold <%= flash_banner_class(type) %>">
          <%= message %>
        </div>
      <% end %>
    </div>
  </noscript>
<% end %>
