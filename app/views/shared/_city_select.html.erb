<%# Município: um botão que abre um menu com busca própria dentro.

    Locais: name, value, label, label_class, field_class e — opcionais —
    required, remote (padrão true) e options (a lista fixa, quando remote
    é false).

    Com `remote` o menu consulta /municipios pela UF escolhida; sem, filtra no
    navegador a lista embutida. O <select> de UF do mesmo <form> precisa trazer
    `data-city-select-state`, que é como o controller o encontra — os dois não
    são vizinhos no DOM, então a ligação é por atributo e não por escopo do
    Stimulus.

    O campo de texto continua sendo o do formulário: o controller o esconde e
    escreve nele. Sem JavaScript sobra um campo comum, que é o que o servidor
    grava de qualquer jeito. %>
<% remote = local_assigns.fetch(:remote, true) %>
<% field_id = name.to_s.parameterize(separator: "_") %>

<div class="relative"
     data-controller="city-select"
     data-action="keydown->city-select#closeOnEscape"
     data-city-select-url-value="<%= cities_path if remote %>"
     data-city-select-text-value="<%= {
           placeholder: t("shared.city.placeholder"),
           empty: t("shared.city.empty"),
           choose_state: t("shared.city.choose_state")
         }.to_json %>">
  <%= label_tag field_id, label, class: label_class %>

  <%= text_field_tag name, value, id: field_id,
        required: local_assigns.fetch(:required, false),
        autocomplete: "address-level2",
        data: { city_select_target: "field" },
        class: field_class %>

  <button type="button" hidden id="<%= field_id %>-button"
          <%= tag.attributes("aria-required": local_assigns.fetch(:required, false).presence) %>
          data-city-select-target="button"
          data-action="city-select#toggle"
          aria-haspopup="listbox" aria-expanded="false" aria-controls="<%= field_id %>-panel"
          class="mt-2 flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-left text-sm transition hover:border-stone-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40">
    <span class="flex min-w-0 items-center gap-2">
      <span class="shrink-0 text-stone-400"><%= ui_icon(:map_pin) %></span>
      <span data-city-select-target="label" class="truncate"></span>
    </span>
    <span class="shrink-0 text-stone-400"><%= ui_icon(:chevron_down, css_class: "h-3.5 w-3.5") %></span>
  </button>

  <%# O Esc está no elemento de fora e não no painel: com o foco no botão, um
      listener preso ao painel não veria a tecla. %>
  <div id="<%= field_id %>-panel" hidden
       data-city-select-target="panel"
       class="absolute inset-x-0 top-full z-40 mt-1 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-lg shadow-stone-900/10">
    <%# A busca própria do menu: é ela que faz a lista caber num acervo de
        5.571 municípios. %>
    <div class="border-b border-stone-200 p-2">
      <div class="relative">
        <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-stone-400">
          <%= ui_icon(:search, css_class: "h-3.5 w-3.5") %>
        </span>
        <input type="text" role="searchbox"
               data-city-select-target="search"
               data-action="input->city-select#typed"
               placeholder="<%= t("shared.city.search") %>"
               aria-label="<%= t("shared.city.search") %>"
               autocomplete="off"
               class="w-full rounded-md border border-stone-300 bg-white py-1.5 pl-8 pr-2 text-sm text-stone-900 placeholder:text-stone-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40">
      </div>
    </div>

    <ul role="listbox" aria-label="<%= label %>" data-city-select-target="list" class="max-h-56 overflow-y-auto py-1"></ul>

    <p data-city-select-target="empty" hidden class="px-4 py-3 text-xs text-stone-500"></p>

    <div class="border-t border-stone-200 p-2">
      <button type="button" data-action="city-select#clear"
              class="w-full cursor-pointer rounded-md px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-stone-500 transition hover:bg-stone-50 hover:text-stone-900">
        <%= t("shared.city.clear") %>
      </button>
    </div>
  </div>

  <% unless remote %>
    <%# Lista fixa (o filtro da vitrine lista só as cidades que têm anúncio).
        Em <script type="application/json"> e não em data-*, que ficaria enorme
        dentro do atributo. %>
    <%= tag.script local_assigns.fetch(:options, []).to_json.html_safe,
          type: "application/json", data: { city_select_target: "options" } %>
  <% end %>
</div>
