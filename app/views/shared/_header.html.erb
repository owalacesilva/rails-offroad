<%# Header global: fixo no topo (sticky) em todas as páginas. Claro, com o
    emblema à esquerda, a navegação ao centro e as ações à direita. %>
<header class="sticky top-0 z-50 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center gap-4">
      <%# Só o emblema: ele já traz o nome do portal desenhado. Sem texto ao lado,
          o alt é o único nome acessível do link. width/height são os do arquivo
          e seguram o espaço antes de carregar. %>
      <%= link_to root_path, class: "flex shrink-0 items-center" do %>
        <%= image_tag "logo.png", alt: t("layout.header.brand"), width: 248, height: 252,
              loading: "eager", class: "h-14 w-auto sm:h-16" %>
      <% end %>

      <%# Navegação central. A partir de lg; abaixo disso vira o menu do fim da barra. %>
      <nav class="mx-auto hidden items-center gap-1 lg:flex" aria-label="<%= t("layout.nav.label") %>">
        <%= link_to root_path, class: nav_link_class do %>
          <svg class="h-4 w-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.5a.75.75 0 0 0 .75.75H9v-6h6v6h3.75a.75.75 0 0 0 .75-.75V9.75" />
          </svg>
          <%= t("layout.nav.home") %>
        <% end %>

        <%= link_to posts_path, class: nav_link_class do %>
          <svg class="h-4 w-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
          <%= t("layout.nav.blog") %>
        <% end %>

        <details class="group relative" data-controller="dropdown">
          <summary class="<%= nav_link_class %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <svg class="h-4 w-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
            <%= t("layout.nav.classifieds") %>
            <svg class="h-3.5 w-3.5 text-stone-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>

          <nav class="absolute left-0 z-50 mt-2 w-64 overflow-hidden rounded-xl border border-stone-200 bg-white py-1 shadow-lg shadow-stone-900/10">
            <%= render "shared/category_links" %>
          </nav>
        </details>
      </nav>

      <%# Ações %>
      <div class="ml-auto flex items-center gap-2 sm:gap-3">
        <%= render "shared/locale_switcher" %>

        <%# Pulsa devagar para se destacar do resto da barra. transition-colors e
            não transition: a animação já mexe no transform, e transicionar a
            mesma propriedade no hover faria os dois brigarem. O ciclo e o
            respeito a prefers-reduced-motion estão em app/assets/tailwind. %>
        <%= link_to new_account_ad_path, class: "inline-flex shrink-0 animate-pulse-slow items-center gap-1.5 rounded-full bg-brand-500 px-4 py-2.5 text-sm font-bold text-stone-950 transition-colors hover:bg-brand-400" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 0 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 0 0 1.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 0 1 0 3.46" />
          </svg>
          <%= t("layout.header.new_ad") %>
        <% end %>

        <% if authenticated? %>
          <%= link_to account_path, class: "hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-stone-700 transition hover:text-brand-600 sm:inline-flex" do %>
            <%= render "shared/user_icon" %>
            <span class="max-w-32 truncate"><%= current_user.name %></span>
          <% end %>
        <% else %>
          <%= link_to login_path, class: "hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-stone-700 transition hover:text-brand-600 sm:inline-flex" do %>
            <%= render "shared/user_icon" %>
            <%= t("layout.header.sign_in") %>
          <% end %>
        <% end %>

        <%# Abaixo de lg a navegação central não cabe: vem toda para cá. %>
        <div class="lg:hidden">
          <%= render layout: "shared/dropdown", locals: { label: t("layout.nav.menu") } do %>
            <%= link_to t("layout.nav.home"), root_path, class: dropdown_item_class %>
            <%= link_to t("layout.nav.blog"), posts_path, class: dropdown_item_class %>
            <%= render "shared/category_links" %>

            <% if authenticated? %>
              <%= link_to current_user.name, account_path, class: separated_dropdown_item_class %>
              <%= button_to t("layout.header.sign_out"), logout_path, method: :delete,
                    class: "#{dropdown_item_class} cursor-pointer" %>
            <% else %>
              <%= link_to t("layout.header.sign_in"), login_path, class: separated_dropdown_item_class %>
            <% end %>

            <%# O seletor de idioma da barra some no mobile; aqui ele reaparece. %>
            <%= render "shared/locale_menu_items" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</header>
