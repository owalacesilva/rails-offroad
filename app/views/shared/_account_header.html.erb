<%# Header da área do anunciante: claro, enxuto, sem a busca do portal. %>
<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex shrink-0 items-center" do %>
      <%= image_tag "logo.png", alt: t("layout.header.brand"), width: 248, height: 252,
            class: "h-11 w-auto" %>
    <% end %>

    <nav class="ml-auto flex items-center gap-3">
      <%= link_to t("layout.account.back_to_portal"), root_path,
            class: "hidden text-sm font-semibold text-stone-500 transition hover:text-stone-900 sm:inline-block" %>
      <%# Mesmo pulso do botão do portal: é o mesmo botão. %>
      <%= link_to t("layout.header.new_ad"), new_account_ad_path,
            class: "animate-pulse-slow rounded-full bg-brand-500 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-950 transition-colors hover:bg-brand-400" %>

      <%# As mesmas funções da navegação lateral, alcançáveis do topo — no mobile
          a lateral fica empurrada para cima do conteúdo. %>
      <%= render layout: "shared/dropdown", locals: { label: current_user.name } do %>
        <%= dropdown_link(account_path, icon: :grid) { t("dashboard.nav.dashboard") } %>

        <%= dropdown_link(account_ads_path, icon: :queue) do %>
          <%= t("dashboard.nav.ads") %>
          <%= render "shared/dropdown_count", count: account_counts[:ads] %>
        <% end %>

        <%= dropdown_link(proposals_path, icon: :inbox) do %>
          <%= t("dashboard.nav.proposals") %>
          <%= render "shared/dropdown_count", count: account_counts[:proposals] %>
        <% end %>

        <%= dropdown_link(edit_profile_path, icon: :user) { t("dashboard.nav.profile") } %>

        <%= dropdown_link(new_account_ad_path, icon: :plus, class: dropdown_separator_class) { t("dashboard.ads_new.title") } %>

        <%= dropdown_link(root_path, icon: :home, class: "#{dropdown_separator_class} sm:hidden") { t("layout.account.back_to_portal") } %>

        <%= render "shared/locale_menu_items" %>

        <%= dropdown_button(logout_path, icon: :logout, method: :delete,
              class: dropdown_separator_class) { t("dashboard.nav.sign_out") } %>
      <% end %>
    </nav>
  </div>
</header>
