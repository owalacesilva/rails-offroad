<%# active: :dashboard, :proposals ou :profile %>
<aside class="lg:col-span-3">
  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-stone-200 text-lg font-extrabold text-stone-600">
        <%= current_advertiser.name.first.upcase %>
      </span>
      <div class="min-w-0">
        <p class="truncate text-sm font-bold text-stone-900"><%= current_advertiser.name %></p>
        <p class="truncate text-xs text-stone-500"><%= current_advertiser.email %></p>
      </div>
    </div>
    <span class="mt-3 inline-block rounded-full bg-stone-100 px-2.5 py-1 text-[11px] font-semibold text-stone-600">
      <%= t("dashboard.member") %>
    </span>
  </div>

  <nav class="mt-4 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
    <%= link_to account_path,
          class: "flex items-center gap-3 border-l-4 px-5 py-3.5 text-sm font-bold transition #{active == :dashboard ? 'border-brand-500 bg-brand-50 text-stone-800' : 'border-transparent text-stone-500 hover:bg-stone-50 hover:text-stone-900'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
      </svg>
      <%= t("dashboard.nav.dashboard") %>
    <% end %>

    <%= link_to proposals_path,
          class: "flex items-center gap-3 border-l-4 px-5 py-3.5 text-sm font-bold transition #{active == :proposals ? 'border-brand-500 bg-brand-50 text-stone-800' : 'border-transparent text-stone-500 hover:bg-stone-50 hover:text-stone-900'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
      </svg>
      <%= t("dashboard.nav.proposals") %>
      <% proposals_count = Proposal.where(listing: current_advertiser.listings).count %>
      <% if proposals_count.positive? %>
        <span class="ml-auto rounded-full bg-stone-200 px-2 py-0.5 text-[11px] font-bold text-stone-700"><%= proposals_count %></span>
      <% end %>
    <% end %>

    <%= link_to edit_profile_path,
          class: "flex items-center gap-3 border-l-4 px-5 py-3.5 text-sm font-bold transition #{active == :profile ? 'border-brand-500 bg-brand-50 text-stone-800' : 'border-transparent text-stone-500 hover:bg-stone-50 hover:text-stone-900'}" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
      </svg>
      <%= t("dashboard.nav.profile") %>
    <% end %>

    <%= button_to logout_path, method: :delete,
          class: "flex w-full cursor-pointer items-center gap-3 border-l-4 border-transparent px-5 py-3.5 text-left text-sm font-semibold text-stone-500 transition hover:bg-stone-50 hover:text-stone-900" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
      </svg>
      <%= t("dashboard.nav.sign_out") %>
    <% end %>
  </nav>
</aside>
