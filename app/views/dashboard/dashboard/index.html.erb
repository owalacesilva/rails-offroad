<% content_for :title, "#{t('dashboard.title')} — OffRoad Classificados" %>

<div class="flex flex-wrap items-baseline justify-between gap-2">
  <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.title") %></h1>
  <p class="text-sm text-stone-500"><%= l(Date.current, format: :long) %></p>
</div>

<%# Três números, sem preenchimento colorido: o valor é o dado, não o card. %>
<div class="mt-6 grid gap-4 sm:grid-cols-3">
  <%= link_to account_ads_path, class: "rounded-xl border border-stone-200 bg-white p-5 transition hover:border-stone-400" do %>
    <p class="text-3xl font-extrabold tabular-nums text-stone-900"><%= @ads.size %></p>
    <p class="mt-1 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.stats.ads") %></p>
  <% end %>

  <%= link_to proposals_path, class: "rounded-xl border border-stone-200 bg-white p-5 transition hover:border-stone-400" do %>
    <p class="text-3xl font-extrabold tabular-nums text-stone-900"><%= @proposals_count %></p>
    <p class="mt-1 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.stats.proposals") %></p>
  <% end %>

  <div class="rounded-xl border border-stone-200 bg-white p-5">
    <p class="text-3xl font-extrabold tabular-nums text-stone-900"><%= @ads_by_category.size %></p>
    <p class="mt-1 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.stats.categories") %></p>
  </div>
</div>

<%# Situação na moderação. Só anúncio aprovado aparece no portal, então o
    anunciante precisa ver o que está parado antes de qualquer outra coisa. %>
<h2 class="mt-10 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.by_status") %></h2>
<div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  <% Ad::STATUSES.each_value do |status| %>
    <%= link_to account_ads_path(status: status),
          class: "flex items-center justify-between gap-3 rounded-xl border border-stone-200 bg-white px-5 py-4 transition hover:border-stone-400" do %>
      <%= ad_status_badge(status) %>
      <span class="text-xl font-extrabold tabular-nums text-stone-900"><%= @ads_by_status.fetch(status, 0) %></span>
    <% end %>
  <% end %>
</div>

<%# Anúncios por categoria %>
<h2 class="mt-10 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.by_category") %></h2>
<div class="mt-3 overflow-hidden rounded-xl border border-stone-200 bg-white">
  <% @categories.each_with_index do |category, index| %>
    <div class="flex items-center justify-between gap-4 px-5 py-3.5 <%= "border-t border-stone-100" unless index.zero? %>">
      <span class="truncate text-sm font-semibold text-stone-700"><%= category.name %></span>
      <span class="text-sm font-extrabold tabular-nums text-stone-900"><%= @ads_by_category[category.slug].to_i %></span>
    </div>
  <% end %>
</div>
