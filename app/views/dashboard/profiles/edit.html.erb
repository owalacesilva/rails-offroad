<% content_for :title, "#{t('profiles.edit.title')} — OffRoad Classificados" %>

<section class="min-h-full bg-stone-100 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-7xl">
    <nav class="flex items-center gap-2 text-xs font-semibold text-stone-500" aria-label="Breadcrumb">
      <%= link_to t("dashboard.breadcrumb_home"), root_path, class: "hover:text-brand-600" %>
      <span>&gt;</span>
      <%= link_to t("dashboard.breadcrumb_account"), account_path, class: "hover:text-brand-600" %>
      <span>&gt;</span>
      <span class="text-brand-600"><%= t("dashboard.nav.profile") %></span>
    </nav>

    <div class="mt-6 grid gap-6 lg:grid-cols-12">
      <%= render "dashboard/dashboard/sidebar", active: :profile %>

      <div class="lg:col-span-9">
        <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("profiles.edit.title") %></h1>
        <p class="mt-1 text-sm text-stone-500"><%= t("profiles.edit.subtitle") %></p>

        <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
          <%= form_with model: @advertiser, url: profile_path, method: :patch, class: "space-y-4" do |form| %>
            <% if @advertiser.errors.any? %>
              <div role="alert" class="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-700">
                <p class="font-bold"><%= t("profiles.edit.errors", count: @advertiser.errors.count) %></p>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  <% @advertiser.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div>
              <%= form.label :name, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
              <%= form.text_field :name, required: true, autocomplete: "name",
                    class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <%= form.label :email, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                <%= form.email_field :email, required: true, autocomplete: "email",
                      class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
              </div>

              <div>
                <%= form.label :phone, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "(41) 98877-0011",
                      class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
                <p class="mt-1 text-xs text-stone-400"><%= t("profiles.edit.phone_hint") %></p>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <div class="sm:col-span-2">
                <%= form.label :city, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                <%= form.text_field :city, required: true, autocomplete: "address-level2",
                      class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
              </div>

              <div>
                <%= form.label :state, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                <%= form.select :state, Advertiser::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
                      class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
              </div>
            </div>

            <div class="border-t border-stone-200 pt-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-stone-500"><%= t("profiles.edit.password_section") %></p>
              <p class="mt-1 text-xs text-stone-400"><%= t("profiles.edit.password_hint") %></p>

              <div class="mt-3 grid gap-4 sm:grid-cols-2">
                <div>
                  <%= form.label :password, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                  <%= form.password_field :password, autocomplete: "new-password",
                        class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
                </div>

                <div>
                  <%= form.label :password_confirmation, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
                  <%= form.password_field :password_confirmation, autocomplete: "new-password",
                        class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
                </div>
              </div>
            </div>

            <%= form.submit t("profiles.edit.submit"),
                  class: "w-full cursor-pointer rounded-full bg-brand-500 px-6 py-3 text-sm font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400 sm:w-auto" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
