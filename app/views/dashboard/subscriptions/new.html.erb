<% content_for :title, "#{t('dashboard.premium.title')} — OffRoad Classificados" %>
<% content_for :breadcrumb, t("dashboard.nav.premium") %>

<h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.premium.title") %></h1>
<p class="mt-1 text-sm text-stone-500"><%= t("dashboard.premium.subtitle") %></p>

<%# Situação primeiro: quem já assinou vem aqui para saber até quando vale, e
    quem não assinou vem para assinar. As duas respostas na mesma faixa. %>
<div class="mt-6 rounded-xl border p-5 <%= @premium_until ? "border-emerald-300 bg-emerald-50" : "border-stone-200 bg-white" %>">
  <% if @premium_until %>
    <p class="text-sm font-bold text-emerald-800"><%= t("dashboard.premium.active") %></p>
    <p class="mt-1 text-sm text-emerald-700">
      <%= t("dashboard.premium.until", date: l(@premium_until, format: :long)) %>
    </p>
  <% else %>
    <p class="text-sm font-bold text-stone-900"><%= t("dashboard.premium.inactive") %></p>
    <p class="mt-1 text-sm text-stone-500"><%= t("dashboard.premium.inactive_hint") %></p>
  <% end %>
</div>

<% plan = premium_plan %>
<div class="mt-6 rounded-xl border border-stone-200 bg-white p-5 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="text-sm font-extrabold uppercase tracking-wide text-brand-600"><%= plan[:name] %></h2>
    <p class="flex items-baseline gap-2">
      <span class="text-2xl font-extrabold tracking-tight text-stone-900 tabular-nums"><%= plan_price("premium") %></span>
      <span class="text-sm font-semibold text-stone-500"><%= plan[:period] %></span>
    </p>
  </div>

  <%# As mesmas vantagens da página de planos, lidas do mesmo lugar. %>
  <ul class="mt-4 space-y-2.5 border-t border-stone-100 pt-4">
    <% plan[:features].each do |feature| %>
      <li class="flex gap-3 text-sm leading-relaxed text-stone-600">
        <%= ui_icon(:check, css_class: "mt-0.5 h-4 w-4 shrink-0 text-brand-500") %>
        <span><%= feature %></span>
      </li>
    <% end %>
  </ul>

  <div class="mt-6 border-t border-stone-100 pt-5">
    <%= button_to t("dashboard.premium.pay"), account_premium_path,
          class: "flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-stone-950 transition hover:bg-brand-400 sm:w-auto" %>

    <%# Dizer para onde a pessoa vai antes de o navegador sair do portal: o
        cartão é digitado no PagBank, e nenhum dado de cartão passa por aqui. %>
    <p class="mt-3 text-xs leading-relaxed text-stone-500"><%= t("dashboard.premium.gateway_note") %></p>
    <p class="mt-2 text-xs text-stone-500">
      <%= link_to t("dashboard.premium.compare"), pricing_path, class: "font-semibold text-brand-600 transition hover:text-brand-500" %>
    </p>
  </div>
</div>
