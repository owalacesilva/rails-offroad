<% content_for :title, "#{t('dashboard.ads_new.title')} — OffRoad Classificados" %>
<% content_for :breadcrumb, t("dashboard.ads_new.title") %>

<h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.ads_new.title") %></h1>
<p class="mt-1 text-sm text-stone-500"><%= t("dashboard.ads_new.subtitle") %></p>

<div class="mt-6 rounded-xl border border-stone-200 bg-white p-6 sm:p-8">
  <%= form_with model: @ad, url: account_ads_path, method: :post, class: "space-y-5" do |form| %>
    <% if @ad.errors.any? %>
      <div role="alert" class="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-bold"><%= t("dashboard.ads_new.errors", count: @ad.errors.count) %></p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @ad.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
      <%= form.text_field :title, required: true, autofocus: true, placeholder: t("dashboard.ads_new.title_placeholder"),
            class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <%= form.label :category_id, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.collection_select :category_id, Category.ordered, :id, :name, { include_blank: "—" }, required: true,
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      </div>

      <div>
        <%= form.label :price, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.text_field :price, required: true, inputmode: "decimal", placeholder: "45.000,00",
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
        <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.price_hint") %></p>
      </div>

      <div>
        <%= form.label :year, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.number_field :year, in: 1901..(Date.current.year + 1), placeholder: Date.current.year,
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
        <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.year_hint") %></p>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <%= form.label :city, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.text_field :city, required: true, autocomplete: "address-level2",
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      </div>

      <div>
        <%= form.label :state, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.select :state, User::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      </div>
    </div>

    <div>
      <%= form.label :description, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
      <%= form.text_area :description, rows: 6, placeholder: t("dashboard.ads_new.description_placeholder"),
            class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm leading-relaxed text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
    </div>

    <%# As fotos são URLs, não upload: ad_images guarda file_url e sort_order, e
        a ordem das linhas é a ordem das fotos. %>
    <div class="border-t border-stone-200 pt-5">
      <%= label_tag :photo_urls, t("dashboard.ads_new.photos"), class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
      <%= text_area_tag :photo_urls, params[:photo_urls], rows: 5, spellcheck: false,
            placeholder: "https://exemplo.com.br/fotos/frente.jpg\nhttps://exemplo.com.br/fotos/lateral.jpg\nhttps://exemplo.com.br/fotos/interior.jpg",
            class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 font-mono text-xs text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
      <p class="mt-1 text-xs text-stone-400">
        <%= t("dashboard.ads_new.photos_hint", min: Ad::IMAGE_COUNT.min, max: Ad::IMAGE_COUNT.max) %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 border-t border-stone-200 pt-5">
      <%= form.submit t("dashboard.ads_new.submit"),
            class: "cursor-pointer rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
      <%= link_to t("dashboard.ads_new.cancel"), account_ads_path,
            class: "text-xs font-bold uppercase tracking-wide text-stone-400 transition hover:text-stone-900" %>
      <p class="w-full text-xs text-stone-400 sm:w-auto sm:flex-1 sm:text-right">
        <%= t("dashboard.ads_new.moderation_hint") %>
      </p>
    </div>
  <% end %>
</div>
