<% content_for :title, "#{t('dashboard.ads_new.title')} — OffRoad Classificados" %>
<% content_for :breadcrumb, t("dashboard.ads_new.title") %>

<% field_class = "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" %>
<% label_class = "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
<% photos = submitted_photos(params[:photo_signed_ids]) %>

<h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.ads_new.title") %></h1>
<p class="mt-1 text-sm text-stone-500"><%= t("dashboard.ads_new.subtitle") %></p>

<div class="mt-6 rounded-xl border border-stone-200 bg-white p-6 sm:p-8">
  <%# O submit escuta o photo-upload e o category-specs: o botão de publicar só
      destrava com o mínimo de fotos e com as especificações completas, e vira
      "enviando" no envio. A ordem em data-controller importa — ver
      submit_controller.js. %>
  <%= form_with model: @ad, url: account_ads_path, method: :post,
        class: "space-y-6",
        data: {
          controller: "submit category-specs",
          submit_sending_value: t("dashboard.ads_new.sending"),
          category_specs_text_value: {
            counter: t("dashboard.ads_new.specifications_counter"),
            fill: t("dashboard.ads_new.specifications_fill"),
            edit: t("dashboard.ads_new.specifications_edit")
          }.to_json,
          action: "submit->submit#sending turbo:submit-end->submit#restore " \
                  "photo-upload:change->submit#photosChanged category-specs:change->submit#specsChanged"
        } do |form| %>
    <% if @ad.errors.any? %>
      <div role="alert" class="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-bold"><%= t("dashboard.ads_new.errors", count: @ad.errors.count) %></p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @ad.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, class: label_class %>
      <%= form.text_field :title, required: true, autofocus: true, placeholder: t("dashboard.ads_new.title_placeholder"),
            class: field_class %>
    </div>

    <%# ---------------------------------------------------------- Categoria %>
    <%# Emblemas no lugar do select: são quatro opções fixas e ilustradas, e
        cada uma cabe inteira na tela. Por baixo continuam sendo radios — o
        `peer` do Tailwind pinta o rótulo a partir do radio marcado, então
        teclado e leitor de tela veem um grupo de opções comum. %>
    <fieldset>
      <legend class="<%= label_class %>"><%= Ad.human_attribute_name(:category) %></legend>

      <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% Category.ordered.each do |category| %>
          <% field_id = "ad_category_#{category.slug}" %>
          <div class="relative">
            <%# A troca de categoria troca o bloco de especificações exibido. %>
            <%= form.radio_button :category_id, category.id, id: field_id, required: true, class: "peer sr-only",
                  data: { action: "change->category-specs#changed" } %>
            <%# A cor fica no rótulo, não nos filhos: `peer-checked` só alcança
                irmãos do radio, e o ícone herda por currentColor. %>
            <%= label_tag field_id,
                  class: "flex h-full cursor-pointer flex-col items-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-3 py-4 text-center text-stone-500 transition " \
                         "hover:border-brand-400 hover:bg-white hover:text-stone-800 " \
                         "peer-checked:border-brand-500 peer-checked:bg-brand-50 peer-checked:text-brand-700 peer-checked:ring-1 peer-checked:ring-brand-500 " \
                         "peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500/50" do %>
              <%= category_icon_for(category.slug, css_class: "h-6 w-6") %>
              <span class="text-xs font-bold leading-tight"><%= category.name %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= render "shared/money_field", form: form, field: :price, required: true,
              placeholder: "45.000,00", label_class: label_class, field_class: field_class %>
        <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.price_hint") %></p>
      </div>

      <div>
        <%= form.label :year, class: label_class %>
        <%# max no ano corrente acompanha a validação do modelo: ano no futuro
            não é aceito. O navegador barra antes, o servidor barra de novo. %>
        <%= form.number_field :year, in: 1901..Date.current.year, step: 1, placeholder: Date.current.year,
              class: field_class %>
        <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.year_hint") %></p>
      </div>
    </div>

    <%# ------------------------------------------------------ UF e município %>
    <%# O município sai de um menu com busca própria, alimentado por /municipios
        conforme a UF escolhida: os 5.571 do país nunca são carregados de uma vez. %>
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <%= form.label :state, class: label_class %>
        <%= form.select :state, User::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
              class: field_class, data: { city_select_state: true } %>
      </div>

      <div class="sm:col-span-2">
        <%= render "shared/city_select", name: form.field_name(:city), value: form.object.city,
              label: Ad.human_attribute_name(:city), required: true,
              label_class: label_class, field_class: field_class %>
        <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.city_hint") %></p>
      </div>
    </div>

    <%# ---------------------------------------------------------- Descrição %>
    <%= render "shared/rich_text_field", form: form, field: :description,
          label_class: label_class, field_class: field_class,
          placeholder: t("dashboard.ads_new.description_placeholder") %>

    <%# -------------------------------------------------- Especificações (EAV) %>
    <%# As especificações são preenchidas num modal: são até nove campos, e
        deixá-los abertos no formulário empurrava as fotos e o botão de publicar
        para fora da tela.

        Os campos moram dentro do <dialog>, que está dentro do form — diálogo
        fechado é `display: none`, e campo escondido continua sendo enviado. Só o
        bloco da categoria escolhida fica habilitado; os outros são `disabled` e
        por isso não viajam no POST.

        Nenhum campo aqui é `required`: o Chrome recusa submeter um formulário
        com obrigatório que não dá para focar, que é o que um obrigatório dentro
        de diálogo fechado seria. Quem cobra é o modelo, no contexto :submission,
        com o botão de publicar travado enquanto faltar campo. %>
    <div class="border-t border-stone-200 pt-5" data-controller="modal">
      <p class="<%= label_class %>"><%= t("dashboard.ads_new.specifications") %></p>
      <p class="mt-1 text-xs text-stone-400"><%= t("dashboard.ads_new.specifications_hint") %></p>

      <p data-category-specs-target="empty"
         class="mt-3 rounded-lg border border-dashed border-stone-300 bg-stone-50 px-4 py-6 text-center text-xs text-stone-500">
        <%= t("dashboard.ads_new.specifications_empty") %>
      </p>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="button" data-action="modal#open" data-category-specs-target="open" hidden
                class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-stone-300 px-4 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-700 transition hover:border-brand-500 hover:text-brand-600">
          <%= t("dashboard.ads_new.specifications_fill") %>
        </button>

        <p data-category-specs-target="counter" class="text-xs font-semibold text-stone-500"></p>
      </div>

      <%# O que já foi preenchido, para não obrigar a reabrir o modal só para
          conferir. Montado pelo controller a partir dos próprios campos. %>
      <div data-category-specs-target="summary chips" hidden class="mt-3 flex flex-wrap gap-1.5"></div>

      <dialog data-modal-target="dialog"
              data-action="click->modal#closeOnBackdrop"
              aria-labelledby="specs-modal-title"
              class="w-[calc(100%-2rem)] max-w-2xl rounded-2xl border border-stone-300 bg-white p-0 text-stone-900 backdrop:bg-stone-950/80 backdrop:backdrop-blur-sm">
        <div class="flex items-start justify-between gap-4 border-b border-stone-200 p-6">
          <div>
            <h2 id="specs-modal-title" class="text-lg font-bold text-stone-900">
              <%= t("dashboard.ads_new.specifications") %>
            </h2>
            <p class="mt-1 text-sm text-stone-500" data-category-specs-target="modalTitle"></p>
          </div>

          <button type="button" data-action="modal#close"
                  aria-label="<%= t("ads.proposal_modal.close") %>"
                  class="shrink-0 cursor-pointer rounded-full p-1.5 text-stone-500 transition hover:bg-stone-100 hover:text-stone-900">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="max-h-[60vh] overflow-y-auto p-6">
          <% Category.ordered.each do |category| %>
            <div data-category-specs-target="group"
                 data-category-id="<%= category.id %>"
                 data-category-name="<%= category.name %>"
                 hidden>
              <div class="grid gap-4 sm:grid-cols-2">
                <% category.spec_attributes.ordered.each do |attribute| %>
                  <% field_id = "specs_#{category.id}_#{attribute.id}" %>
                  <div>
                    <%= label_tag field_id, attribute.label, class: label_class %>
                    <%= text_field_tag "specs[#{attribute.id}]", params.dig(:specs, attribute.id.to_s),
                          id: field_id, autocomplete: "off",
                          inputmode: attribute.data_type == "INT" ? "numeric" : nil,
                          data: { label: attribute.label, action: "input->category-specs#edited" },
                          class: field_class %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3 border-t border-stone-200 p-6">
          <%# Fechar com o conjunto incompleto é permitido: o Esc já faz isso de
              qualquer jeito, e quem barra o envio é o botão de publicar. %>
          <button type="button" data-action="modal#close"
                  class="cursor-pointer rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400">
            <%= t("dashboard.ads_new.specifications_done") %>
          </button>
        </div>
      </dialog>
    </div>

    <%# ------------------------------------------------------------- Fotos %>
    <div class="border-t border-stone-200 pt-5"
         data-controller="photo-upload"
         data-photo-upload-url-value="<%= account_ad_photos_path %>"
         data-photo-upload-min-value="<%= Ad::IMAGE_COUNT.min %>"
         data-photo-upload-max-value="<%= Ad::IMAGE_COUNT.max %>"
         data-photo-upload-width-value="<%= PhotoUpload::MAX_WIDTH %>"
         data-photo-upload-height-value="<%= PhotoUpload::MAX_HEIGHT %>"
         data-photo-upload-max-bytes-value="<%= PhotoUpload::MAX_BYTES %>"
         data-photo-upload-text-value="<%= {
               prompt: t("dashboard.ads_new.photos_prompt"),
               counter: t("dashboard.ads_new.photos_counter"),
               tooMany: t("dashboard.ads_new.photos_too_many", max: Ad::IMAGE_COUNT.max),
               type: t("uploads.errors.type"),
               tooBig: t("uploads.errors.size", max: PhotoUpload::MAX_BYTES / 1.megabyte),
               failed: t("dashboard.ads_new.photos_failed")
             }.to_json %>">
      <p class="<%= label_class %>"><%= t("dashboard.ads_new.photos") %></p>
      <p class="mt-1 text-xs text-stone-400">
        <%= t("dashboard.ads_new.photos_hint", min: Ad::IMAGE_COUNT.min, max: Ad::IMAGE_COUNT.max,
              width: PhotoUpload::MAX_WIDTH, height: PhotoUpload::MAX_HEIGHT) %>
      </p>

      <%# Fotos que já tinham subido antes de o formulário voltar com erro. %>
      <div data-photo-upload-target="existing" class="grid grid-cols-3 gap-3 sm:grid-cols-5 <%= "mt-3" if photos.any? %>">
        <% photos.each do |photo| %>
          <div data-photo class="group relative aspect-[4/3] overflow-hidden rounded-lg border border-stone-200">
            <%= image_tag photo[:url], alt: photo[:name], class: "h-full w-full object-cover" %>
            <%= hidden_field_tag "photo_signed_ids[]", photo[:signed_id], id: nil %>
            <button type="button" data-action="photo-upload#removeExisting"
                    aria-label="<%= t('dashboard.ads_new.photo_remove') %>"
                    class="absolute right-1 top-1 cursor-pointer rounded-full bg-stone-950/70 p-1 text-white transition hover:bg-red-600">
              <svg class="pointer-events-none h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        <% end %>
      </div>

      <p data-photo-upload-target="fallback"
         class="mt-3 rounded-lg border border-dashed border-stone-300 bg-stone-50 px-4 py-6 text-center text-xs text-stone-500">
        <%= t("dashboard.ads_new.photos_no_js") %>
      </p>

      <div data-photo-upload-target="zone"
           class="dz-zone mt-3 hidden cursor-pointer rounded-lg border-2 border-dashed border-stone-300 bg-stone-50 p-6 text-center transition hover:border-brand-400 hover:bg-white"></div>

      <div data-photo-upload-target="previews" class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-5"></div>

      <template data-photo-upload-target="template">
        <div class="dz-preview group relative aspect-[4/3] overflow-hidden rounded-lg border border-stone-200 bg-stone-100">
          <img data-dz-thumbnail alt="" class="h-full w-full object-cover">
          <div class="dz-progress absolute inset-x-0 bottom-0 h-1 bg-stone-200">
            <span class="dz-upload block h-full bg-brand-500 transition-all" data-dz-uploadprogress></span>
          </div>
          <span class="dz-error-message absolute inset-0 flex items-center bg-red-600/90 p-2 text-[11px] font-semibold leading-tight text-white" data-dz-errormessage></span>
          <button type="button" data-action="photo-upload#remove" class="absolute right-1 top-1 cursor-pointer rounded-full bg-stone-950/70 p-1 text-white transition hover:bg-red-600">
            <svg class="pointer-events-none h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </template>

      <div data-photo-upload-target="inputs" class="hidden"></div>
      <p data-photo-upload-target="counter" class="mt-2 text-xs font-semibold text-stone-500"></p>
    </div>

    <div class="flex flex-wrap items-center gap-3 border-t border-stone-200 pt-5">
      <%# disabled de saída: o photo-upload destrava assim que houver o mínimo
          de fotos. Sem JavaScript o botão continua desabilitado, e é honesto —
          sem JavaScript também não há como enviar foto. %>
      <button type="submit" data-submit-target="button" disabled
              class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400 disabled:cursor-not-allowed disabled:bg-stone-300 disabled:text-stone-500">
        <svg data-submit-target="spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
        </svg>
        <span data-submit-target="label"><%= t("dashboard.ads_new.submit") %></span>
      </button>

      <%= link_to t("dashboard.ads_new.cancel"), account_ads_path,
            class: "text-xs font-bold uppercase tracking-wide text-stone-400 transition hover:text-stone-900" %>

      <div class="w-full space-y-1 text-xs text-stone-400 sm:w-auto sm:flex-1 sm:text-right">
        <p data-submit-target="photosHint"><%= t("dashboard.ads_new.photos_required", min: Ad::IMAGE_COUNT.min) %></p>
        <p data-submit-target="specsHint"><%= t("dashboard.ads_new.specifications_required") %></p>
      </div>
    </div>

    <p class="text-xs text-stone-400"><%= t("dashboard.ads_new.moderation_hint") %></p>
  <% end %>
</div>
