<% content_for :title, "#{t('dashboard.ads_index.title')} — OffRoad Classificados" %>
<% content_for :breadcrumb, t("dashboard.nav.ads") %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.ads_index.title") %></h1>
    <p class="mt-1 text-sm text-stone-500"><%= t("dashboard.ads_index.subtitle") %></p>
  </div>

  <%= link_to new_account_ad_path, class: "inline-flex shrink-0 items-center gap-1.5 rounded-full bg-brand-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    <%= t("dashboard.ads_new.title") %>
  <% end %>
</div>
<p class="mt-2 text-sm text-stone-500"><%= t("dashboard.ads_index.count", count: @ads.size) %></p>

<%# Filtro por situação. Só aparecem as situações que o anunciante tem. %>
<nav class="mt-6 flex flex-wrap gap-2" aria-label="<%= t("dashboard.ads_index.filter_label") %>">
  <%= link_to account_ads_path,
        "aria-current": @status.nil? ? "page" : nil,
        class: "rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{@status.nil? ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
    <%= t("dashboard.ads_index.all") %>
  <% end %>

  <% Ad::STATUSES.each_value do |status| %>
    <% count = @counts.fetch(status, 0) %>
    <% next if count.zero? %>
    <% current = status == @status %>
    <%= link_to account_ads_path(status: status),
          "aria-current": current ? "page" : nil,
          class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-bold uppercase tracking-wide transition #{current ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white text-stone-600 hover:border-stone-900 hover:text-stone-900'}" do %>
      <%= t("ads.statuses.#{status}") %>
      <span class="rounded-full <%= current ? "bg-white/20" : "bg-stone-100" %> px-1.5 py-0.5 text-[10px] tabular-nums"><%= count %></span>
    <% end %>
  <% end %>
</nav>

<% if @ads.any? %>
  <div class="mt-6 overflow-hidden rounded-xl border border-stone-200 bg-white">
    <% @ads.each_with_index do |ad, index| %>
      <article class="flex flex-wrap items-center gap-4 p-4 sm:flex-nowrap <%= "border-t border-stone-100" unless index.zero? %>">
        <% cover = ad.ad_images.first %>
        <div class="h-16 w-24 shrink-0 overflow-hidden rounded-lg bg-stone-100">
          <% if cover.present? %>
            <%= image_tag cover.url, alt: ad.title, loading: "lazy", class: "h-full w-full object-cover" %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center text-stone-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
              </svg>
            </div>
          <% end %>
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-sm font-bold text-stone-900"><%= ad.title %></h2>
            <%= ad_status_badge(ad.status) %>
          </div>
          <p class="mt-1 text-xs text-stone-500">
            <%= ad.category.name %> &middot; <%= ad.city %>, <%= ad.state %> &middot;
            <%= t("dashboard.ads_index.images", count: ad.ad_images.size) %>
          </p>

          <%# O anunciante precisa saber por que o anúncio não está no ar. %>
          <% if ad.pending? %>
            <p class="mt-1.5 text-xs text-amber-700"><%= t("dashboard.ads_index.hints.pending") %></p>
          <% elsif ad.rejected? %>
            <p class="mt-1.5 text-xs text-red-700"><%= t("dashboard.ads_index.hints.rejected") %></p>
          <% elsif ad.draft? %>
            <p class="mt-1.5 text-xs text-stone-500"><%= t("dashboard.ads_index.hints.draft") %></p>
          <% end %>
        </div>

        <p class="shrink-0 text-sm font-extrabold tabular-nums text-stone-900"><%= ad_price(ad.price) %></p>

        <div class="shrink-0">
          <% if ad.approved? %>
            <%= link_to t("dashboard.ads_index.view"), ad_path(ad),
                  class: "rounded-full border border-stone-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-brand-500 hover:text-brand-600" %>
          <% else %>
            <span class="rounded-full border border-stone-200 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-400">
              <%= t("dashboard.ads_index.not_public") %>
            </span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="mt-6 rounded-xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
    <h2 class="text-lg font-bold text-stone-800"><%= t("dashboard.ads_index.empty.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("dashboard.ads_index.empty.subtitle") %></p>
  </div>
<% end %>
