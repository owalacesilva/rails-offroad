<% content_for :title, "#{t('dashboard.title')} — OffRoad Classificados" %>

<section class="min-h-full bg-stone-100 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-7xl">
    <nav class="flex items-center gap-2 text-xs font-semibold text-stone-500" aria-label="Breadcrumb">
      <%= link_to t("dashboard.breadcrumb_home"), root_path, class: "hover:text-brand-600" %>
      <span>&gt;</span>
      <span class="text-brand-600"><%= t("dashboard.breadcrumb_account") %></span>
    </nav>

    <div class="mt-6 grid gap-6 lg:grid-cols-12">
      <%# ------------------------------------------------------- Sidebar %>
      <aside class="lg:col-span-3">
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-stone-200 text-lg font-extrabold text-stone-600">
              <%= current_advertiser.name.first.upcase %>
            </span>
            <div class="min-w-0">
              <p class="truncate text-sm font-bold text-stone-900"><%= current_advertiser.name %></p>
              <p class="truncate text-xs text-stone-500"><%= current_advertiser.email %></p>
            </div>
          </div>
          <span class="mt-3 inline-block rounded-full bg-stone-100 px-2.5 py-1 text-[11px] font-semibold text-stone-600">
            <%= t("dashboard.member") %>
          </span>
        </div>

        <nav class="mt-4 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
          <%= link_to account_path, class: "flex items-center gap-3 border-l-4 border-brand-500 bg-brand-50 px-5 py-3.5 text-sm font-bold text-stone-800" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
            <%= t("dashboard.nav.dashboard") %>
          <% end %>

          <%= button_to logout_path, method: :delete,
                class: "flex w-full cursor-pointer items-center gap-3 border-l-4 border-transparent px-5 py-3.5 text-left text-sm font-semibold text-stone-500 transition hover:bg-stone-50 hover:text-stone-900" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
            </svg>
            <%= t("dashboard.nav.sign_out") %>
          <% end %>
        </nav>
      </aside>

      <%# --------------------------------------------------------- Main %>
      <div class="lg:col-span-9">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.title") %></h1>
          <p class="text-sm text-stone-500"><%= l(Date.current, format: :long) %></p>
        </div>

        <%# Cards de estatísticas %>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-indigo-500 p-5 text-white shadow-sm">
            <p class="text-3xl font-extrabold"><%= @listings.size %></p>
            <p class="mt-1 text-xs font-bold uppercase tracking-wide text-indigo-100"><%= t("dashboard.stats.listings") %></p>
          </div>

          <div class="rounded-2xl bg-orange-500 p-5 text-white shadow-sm">
            <p class="text-3xl font-extrabold"><%= @proposals_count %></p>
            <p class="mt-1 text-xs font-bold uppercase tracking-wide text-orange-100"><%= t("dashboard.stats.proposals") %></p>
          </div>

          <div class="rounded-2xl bg-emerald-500 p-5 text-white shadow-sm">
            <p class="text-3xl font-extrabold"><%= @listings_by_category.size %></p>
            <p class="mt-1 text-xs font-bold uppercase tracking-wide text-emerald-100"><%= t("dashboard.stats.categories") %></p>
          </div>
        </div>

        <%# Anúncios por categoria %>
        <h2 class="mt-8 text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.by_category") %></h2>
        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <% @categories.each do |category| %>
            <div class="rounded-2xl border border-stone-200 bg-white p-5 text-center shadow-sm">
              <p class="text-2xl font-extrabold text-stone-900"><%= @listings_by_category[category.slug].to_i %></p>
              <p class="mt-1 truncate text-xs font-semibold uppercase tracking-wide text-stone-500"><%= category.name %></p>
            </div>
          <% end %>
        </div>

        <%# Gráficos %>
        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.charts.distribution") %></h3>
            <div class="mt-10 flex flex-col items-center justify-center py-10 text-stone-300">
              <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-19.5 0v6a2.25 2.25 0 0 0 2.25 2.25h15a2.25 2.25 0 0 0 2.25-2.25v-6m-19.5 0 4.72-4.72a1.5 1.5 0 0 1 2.122 0l2.318 2.318a1.5 1.5 0 0 0 2.122 0L18 9" />
              </svg>
              <p class="mt-3 text-sm font-semibold text-stone-400"><%= t("dashboard.charts.no_listings") %></p>
            </div>
          </div>

          <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("dashboard.charts.proportion") %></h3>
            <div class="mt-10 flex flex-col items-center justify-center py-10 text-stone-300">
              <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-19.5 0v6a2.25 2.25 0 0 0 2.25 2.25h15a2.25 2.25 0 0 0 2.25-2.25v-6m-19.5 0 4.72-4.72a1.5 1.5 0 0 1 2.122 0l2.318 2.318a1.5 1.5 0 0 0 2.122 0L18 9" />
              </svg>
              <p class="mt-3 text-sm font-semibold text-stone-400"><%= t("dashboard.charts.no_data") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
