<% content_for :title, "#{t('dashboard.proposals_index.title')} — OffRoad Classificados" %>
<% content_for :breadcrumb, t("dashboard.nav.proposals") %>

<div class="flex flex-wrap items-baseline justify-between gap-2">
  <h1 class="text-2xl font-extrabold tracking-tight text-stone-900 sm:text-3xl"><%= t("dashboard.proposals_index.title") %></h1>
  <p class="text-sm text-stone-500"><%= t("dashboard.proposals_index.count", count: @proposals.size) %></p>
</div>
<p class="mt-1 text-sm text-stone-500"><%= t("dashboard.proposals_index.subtitle") %></p>

<% if @proposals.any? %>
  <div class="mt-6 space-y-3">
    <% @proposals.each do |proposal| %>
      <%# Um controller de modal por proposta: o <dialog> é irmão do card e o
          botão abaixo é quem o abre. O layout do card em si não mudou. %>
      <article class="rounded-xl border border-stone-200 bg-white p-5" data-controller="modal">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <%= link_to proposal.ad.title, ad_path(proposal.ad),
                  class: "text-sm font-bold text-stone-900 transition hover:text-brand-600" %>
            <p class="mt-0.5 text-xs text-stone-500">
              <%= t("dashboard.proposals_index.received_at", date: l(proposal.created_at, format: :long)) %>
            </p>
          </div>
          <p class="text-lg font-extrabold tabular-nums text-stone-900"><%= ad_price(proposal.offered_value) %></p>
        </div>

        <div class="mt-4 grid gap-4 border-t border-stone-100 pt-4 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-stone-400"><%= t("dashboard.proposals_index.contact") %></p>
            <p class="mt-1 text-sm font-semibold text-stone-800"><%= proposal.name %></p>
            <p class="text-sm text-stone-500"><%= mail_to proposal.email, proposal.email, class: "transition hover:text-brand-600" %></p>
            <% if proposal.phone.present? %>
              <p class="text-sm text-stone-500"><%= proposal.phone %></p>
            <% end %>
          </div>

          <% if proposal.message.present? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-stone-400"><%= t("dashboard.proposals_index.message") %></p>
              <p class="mt-1 whitespace-pre-line text-sm text-stone-600"><%= proposal.message %></p>
            </div>
          <% end %>
        </div>

        <div class="mt-4 border-t border-stone-100 pt-4">
          <button type="button" data-action="modal#open"
                  class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-stone-300 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-600 transition hover:border-brand-500 hover:text-brand-600">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <%= t("dashboard.proposals_index.details") %>
          </button>
        </div>

        <%= render "dashboard/proposals/details", proposal: proposal %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="mt-6 rounded-xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
    <h2 class="text-lg font-bold text-stone-800"><%= t("dashboard.proposals_index.empty.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("dashboard.proposals_index.empty.subtitle") %></p>
  </div>
<% end %>
