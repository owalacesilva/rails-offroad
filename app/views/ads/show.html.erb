<% content_for :title, "#{@ad.title} — OffRoad Classificados" %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
  <nav class="flex flex-wrap items-center gap-2 text-xs text-stone-500">
    <%= link_to t("ads.title"), ads_path, class: "transition hover:text-brand-600" %>
    <span aria-hidden="true">/</span>
    <%= link_to @ad.category.name, ads_path(category: @ad.category.slug), class: "transition hover:text-brand-600" %>
    <span aria-hidden="true">/</span>
    <span class="text-stone-600"><%= @ad.title %></span>
  </nav>

  <div class="mt-6 grid gap-8 lg:grid-cols-3">
    <div class="space-y-8 lg:col-span-2">
      <%= render "ads/gallery", ad: @ad %>

      <%# ------------------------------------------------------ Descrição %>
      <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6 sm:p-8">
        <h2 class="text-sm font-bold uppercase tracking-wide text-stone-900"><%= t("ads.show.description") %></h2>

        <% if @ad.description.present? %>
          <div class="mt-4 space-y-3 text-sm leading-relaxed text-stone-600">
            <%= simple_format @ad.description %>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-stone-500"><%= t("ads.show.no_description") %></p>
        <% end %>
      </div>

      <%# ------------------------------------------------ Especificações (EAV) %>
      <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6 sm:p-8">
        <h2 class="text-sm font-bold uppercase tracking-wide text-stone-900"><%= t("ads.show.specifications") %></h2>

        <% specifications = @ad.ordered_specifications %>
        <% if specifications.any? %>
          <dl class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            <% specifications.each do |key, value| %>
              <div class="flex items-baseline justify-between gap-4 border-b border-stone-200 pb-3">
                <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500"><%= specification_label(key) %></dt>
                <dd class="text-right text-sm font-semibold text-stone-900"><%= specification_value(key, value) %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-4 text-sm text-stone-500"><%= t("ads.show.no_specifications") %></p>
        <% end %>
      </div>
    </div>

    <%# -------------------------------------------- Preço, contato, anunciante %>
    <aside data-controller="modal" data-modal-open-value="<%= @proposal.errors.any? %>"
           class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
        <h1 class="text-xl font-extrabold leading-snug tracking-tight text-stone-900"><%= @ad.title %></h1>

        <p class="mt-4 text-3xl font-extrabold tracking-tight text-brand-600">
          <%= ad_price(@ad.price) %>
        </p>

        <dl class="mt-5 space-y-2.5 text-sm text-stone-500">
          <% if @ad.year.present? %>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0 text-stone-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
              <dt class="sr-only"><%= Ad.human_attribute_name(:year) %></dt>
              <dd><%= @ad.year %></dd>
            </div>
          <% end %>

          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <dt class="sr-only"><%= Ad.human_attribute_name(:city) %></dt>
            <dd><%= @ad.city %>, <%= @ad.state %></dd>
          </div>

          <% if @ad.published_at.present? %>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0 text-stone-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <dt class="sr-only"><%= Ad.human_attribute_name(:published_at) %></dt>
              <dd><%= t("ads.show.published_at", date: l(@ad.published_at.to_date, format: :long)) %></dd>
            </div>
          <% end %>
        </dl>

        <div class="mt-6 space-y-3">
          <%= link_to whatsapp_url(@ad), target: "_blank", rel: "noopener noreferrer",
                class: "flex w-full items-center justify-center gap-2 rounded-full bg-emerald-500 px-6 py-3.5 text-sm font-bold uppercase tracking-wide text-stone-950 transition hover:bg-emerald-400" do %>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.09 3.2 5.07 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35ZM12.05 2C6.58 2 2.13 6.45 2.13 11.92c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.8 1.22h.01c5.46 0 9.91-4.45 9.91-9.92C21.97 6.45 17.52 2 12.05 2Z" />
            </svg>
            <%= t("ads.show.whatsapp") %>
          <% end %>

          <button type="button" data-action="modal#open"
                  class="flex w-full items-center justify-center gap-2 rounded-full border border-brand-500 px-6 py-3.5 text-sm font-bold uppercase tracking-wide text-brand-600 transition hover:bg-brand-500 hover:text-stone-950">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 9.16a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <%= t("ads.show.propose") %>
          </button>
        </div>
      </div>

      <%# ---------------------------------------------------- Anunciante %>
      <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
        <h2 class="text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("ads.show.advertiser") %></h2>

        <div class="mt-4 flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-base font-extrabold text-brand-600 ring-1 ring-brand-500/30">
            <%= @ad.user.name.first.upcase %>
          </span>

          <div class="min-w-0">
            <p class="truncate text-base font-bold text-stone-900"><%= @ad.user.name %></p>
            <p class="mt-0.5 flex items-center gap-1.5 text-sm text-stone-500">
              <svg class="h-3.5 w-3.5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <%= @ad.user.location %>
            </p>
          </div>
        </div>

        <p class="mt-4 border-t border-stone-200 pt-4 text-xs text-stone-500">
          <%= t("ads.show.member_since", date: l(@ad.user.member_since, format: :long)) %>
        </p>
      </div>

      <%= render "ads/proposal_modal", ad: @ad, proposal: @proposal %>
    </aside>
  </div>

  <%# ------------------------------------------------ Anúncios relacionados %>
  <section class="mt-14 border-t border-stone-200 pt-10">
    <h2 class="text-2xl font-extrabold tracking-tight text-stone-900"><%= t("ads.show.related") %></h2>

    <% if @related.any? %>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <%= render partial: "ads/card", collection: @related, as: :ad %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-stone-500"><%= t("ads.show.no_related") %></p>
    <% end %>
  </section>
</section>
