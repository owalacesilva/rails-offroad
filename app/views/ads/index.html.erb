<% content_for :title, "#{t('ads.title')} — OffRoad Classificados" %>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <header class="max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"><%= t("ads.title") %></h1>
    <p class="mt-2 text-sm text-stone-400"><%= t("ads.subtitle") %></p>
  </header>

  <%# ------------------------------------------------------ Filtros %>
  <div data-controller="filters" class="mt-8 overflow-hidden rounded-2xl border border-stone-800 bg-stone-900">
    <div class="flex items-center justify-between gap-4 px-5 py-4">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
        </svg>
        <h2 class="text-sm font-bold uppercase tracking-wide text-white"><%= t("ads.filters.title") %></h2>

        <% if @filter.applied? %>
          <span class="rounded-full bg-brand-500/15 px-2.5 py-1 text-[11px] font-bold text-brand-300 ring-1 ring-brand-500/30">
            <%= t("ads.filters.applied", count: @filter.applied_count) %>
          </span>
        <% end %>
      </div>

      <button type="button"
              data-action="filters#toggle"
              data-filters-target="toggle"
              aria-expanded="true"
              aria-controls="ad-filters"
              class="inline-flex items-center gap-2 rounded-full border border-stone-700 px-4 py-2 text-xs font-bold uppercase tracking-wide text-stone-200 transition hover:border-brand-500 hover:text-brand-300">
        <%= t("ads.filters.title") %>
        <svg data-filters-target="chevron" class="h-4 w-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </div>

    <div id="ad-filters" data-filters-target="panel" class="border-t border-stone-800">
      <%= form_with url: ads_path, method: :get do %>
        <div class="grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <%= label_tag :category, t("ads.filters.category"), class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
            <%= select_tag :category,
                  options_for_select([ [ t("ads.filters.any_category"), "" ] ] + @filter.category_options, @filter.category),
                  class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>

          <div>
            <%= label_tag :state, t("ads.filters.state"), class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
            <%= select_tag :state,
                  options_for_select([ [ t("ads.filters.any_state"), "" ] ] + @filter.state_options, @filter.state),
                  data: { action: "change->filters#resetCity" },
                  class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>

          <div>
            <%= label_tag :city, t("ads.filters.city"), class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
            <%= select_tag :city,
                  options_for_select([ [ t("ads.filters.any_city"), "" ] ] + @filter.city_options, @filter.city),
                  class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>

          <div>
            <%= label_tag :sort, t("ads.filters.sort"), class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
            <%= select_tag :sort,
                  options_for_select(@filter.sort_options, @filter.sort),
                  class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-stone-800 px-5 py-4">
          <button type="submit" class="inline-flex items-center rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400">
            <%= t("ads.filters.apply") %>
          </button>

          <% if @filter.applied? %>
            <%= link_to t("ads.filters.clear"), ads_path,
                  class: "text-xs font-bold uppercase tracking-wide text-stone-400 transition hover:text-brand-300" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---------------------------------------------------- Resultados %>
  <div class="mt-8 flex flex-wrap items-baseline justify-between gap-2">
    <p class="text-sm font-semibold text-stone-200">
      <%= t("ads.results", count: @pagination.total_count, formatted: number_with_delimiter(@pagination.total_count)) %>
    </p>

    <% if @pagination.total_count.positive? %>
      <p class="text-xs text-stone-500">
        <%= t("ads.pagination.showing", from: @pagination.from, to: @pagination.to, total: number_with_delimiter(@pagination.total_count)) %>
      </p>
    <% end %>
  </div>

  <% if @ads.any? %>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <%= render partial: "ads/card", collection: @ads, as: :ad %>
    </div>

    <% if @pagination.many_pages? %>
      <%= render "ads/pagination", pagination: @pagination %>
    <% end %>
  <% else %>
    <div class="mt-6 rounded-2xl border border-dashed border-stone-700 bg-stone-900/40 px-6 py-16 text-center">
      <svg class="mx-auto h-10 w-10 text-stone-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <h3 class="mt-4 text-lg font-bold text-white"><%= t("ads.empty.title") %></h3>
      <p class="mt-2 text-sm text-stone-400"><%= t("ads.empty.subtitle") %></p>

      <% if @filter.applied? %>
        <%= link_to t("ads.filters.clear"), ads_path,
              class: "mt-6 inline-flex items-center rounded-full bg-brand-500 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
      <% end %>
    </div>
  <% end %>
</section>
