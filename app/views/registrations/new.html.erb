<% content_for :title, "#{t('registrations.new.title')} — OffRoad Classificados" %>

<section class="mx-auto max-w-xl px-4 py-16 sm:px-6 lg:py-24">
  <div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-extrabold tracking-tight text-stone-900"><%= t("registrations.new.title") %></h1>
    <p class="mt-2 text-sm text-stone-500"><%= t("registrations.new.subtitle") %></p>

    <% if @oauth %>
      <%# Cadastro que começou no provedor: nome e e-mail já vieram de lá, e o
          que falta é o que provedor nenhum informa — telefone, cidade e UF. %>
      <div class="mt-6 flex items-start gap-3 rounded-lg border border-brand-500/30 bg-brand-500/10 p-4">
        <%= oauth_icon(@oauth.provider) %>
        <div class="text-sm leading-relaxed text-stone-700">
          <p>
            <%= t("registrations.new.oauth_intro_html",
                  provider: OauthProvider::PROVIDERS.dig(@oauth.provider.to_sym, :label),
                  email: tag.strong(@oauth.email)) %>
          </p>
          <%= link_to t("registrations.new.oauth_abandon"), signup_path(oauth: "cancelar"),
                class: "mt-1 inline-block text-xs font-bold text-brand-600 underline transition hover:text-brand-500" %>
        </div>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path, method: :post, class: "mt-8 space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div role="alert" class="rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-700">
          <p class="font-bold"><%= t("registrations.new.errors", count: @user.errors.count) %></p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name",
              class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :email, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
          <%= render layout: "shared/leading_icon", locals: { icon: :envelope } do %>
            <%# Vindo do provedor o campo é só leitura, e o controller ignora o
                que for enviado nele: o e-mail que vale é o que o Google ou o
                Facebook confirmou. %>
            <%= form.email_field :email, required: true, autocomplete: "email",
                  readonly: @oauth.present?,
                  class: "mt-2 w-full rounded-lg border border-stone-300 bg-white pl-10 pr-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 #{'bg-stone-100 text-stone-500' if @oauth}" %>
          <% end %>
        </div>

        <div>
          <%= form.label :phone, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
          <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "(41) 9 8877-0011",
                data: { controller: "mask", mask_type_value: "phone", action: "input->mask#format" },
                class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          <p class="mt-1 text-xs text-stone-500"><%= t("registrations.new.phone_hint") %></p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="sm:col-span-2">
          <%= render "shared/city_select", name: form.field_name(:city), value: form.object.city,
                label: User.human_attribute_name(:city), required: true,
                label_class: "block text-xs font-semibold uppercase tracking-wide text-stone-500",
                field_class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>

        <div>
          <%= form.label :state, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
          <%= form.select :state, User::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
                data: { city_select_state: true },
                class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>
      </div>

      <%# Sem senha no cadastro por provedor: quem entra pelo Google entra pelo
          Google. Uma senha pode ser definida depois, no perfil. %>
      <% unless @oauth %>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :password, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password",
                  class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>

          <div>
            <%= form.label :password_confirmation, class: "block text-xs font-semibold uppercase tracking-wide text-stone-500" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                  class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          </div>
        </div>
      <% end %>

      <%= form.submit t("registrations.new.submit"),
            class: "w-full cursor-pointer rounded-full bg-brand-500 px-6 py-3 text-sm font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
    <% end %>

    <% unless @oauth %>
      <%= render "shared/oauth_buttons", label_key: "shared.oauth.sign_up" %>
    <% end %>

    <p class="mt-6 border-t border-stone-200 pt-6 text-center text-sm text-stone-500">
      <%= t("registrations.new.have_account") %>
      <%= link_to t("registrations.new.login"), login_path, class: "font-bold text-brand-600 transition hover:text-brand-600" %>
    </p>
  </div>
</section>
