<% content_for :title, "#{t('registrations.new.title')} — OffRoad Classificados" %>

<section class="mx-auto max-w-xl px-4 py-16 sm:px-6 lg:py-24">
  <div class="rounded-2xl border border-stone-800 bg-stone-900 p-8">
    <h1 class="text-2xl font-extrabold tracking-tight text-white"><%= t("registrations.new.title") %></h1>
    <p class="mt-2 text-sm text-stone-400"><%= t("registrations.new.subtitle") %></p>

    <%= form_with model: @user, url: signup_path, method: :post, class: "mt-8 space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div role="alert" class="rounded-lg border border-red-500/40 bg-red-500/10 p-4 text-sm text-red-200">
          <p class="font-bold"><%= t("registrations.new.errors", count: @user.errors.count) %></p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name",
              class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :email, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.email_field :email, required: true, autocomplete: "email",
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>

        <div>
          <%= form.label :phone, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "(41) 98877-0011",
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
          <p class="mt-1 text-xs text-stone-500"><%= t("registrations.new.phone_hint") %></p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="sm:col-span-2">
          <%= form.label :city, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.text_field :city, required: true, autocomplete: "address-level2",
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>

        <div>
          <%= form.label :state, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.select :state, User::BRAZILIAN_STATES, { include_blank: "—" }, required: true,
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :password, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password",
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>

        <div>
          <%= form.label :password_confirmation, class: "block text-xs font-semibold uppercase tracking-wide text-stone-400" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                class: "mt-2 w-full rounded-lg border border-stone-700 bg-stone-950 px-3 py-2.5 text-sm text-stone-100 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
        </div>
      </div>

      <%= form.submit t("registrations.new.submit"),
            class: "w-full cursor-pointer rounded-full bg-brand-500 px-6 py-3 text-sm font-bold uppercase tracking-wide text-stone-950 transition hover:bg-brand-400" %>
    <% end %>

    <p class="mt-6 border-t border-stone-800 pt-6 text-center text-sm text-stone-400">
      <%= t("registrations.new.have_account") %>
      <%= link_to t("registrations.new.login"), login_path, class: "font-bold text-brand-400 transition hover:text-brand-300" %>
    </p>
  </div>
</section>
