<%# Home. O Header e o Footer ficam no layout (app/views/layouts/application.html.erb).

    A ordem das seções abaixo do hero é fixa e foi pedida assim: recentes,
    galeria, mais vistos, agenda, newsletter e galeria de novo. Mexer na ordem
    aqui é mexer no pedido, não no layout. %>

<%# ---------------------------------------------------------------- Hero %>
<section class="relative overflow-hidden bg-stone-900">
  <!-- Espaço para a imagem temática: troque o gradiente abaixo por
       image_tag "hero-trilha.jpg", class: "absolute inset-0 h-full w-full object-cover" -->
  <div class="absolute inset-0"
       style="background-image:
         radial-gradient(circle at 12% 15%, rgba(249, 128, 7, 0.30), transparent 55%),
         radial-gradient(circle at 88% 8%, rgba(183, 60, 6, 0.26), transparent 52%),
         radial-gradient(circle at 50% 120%, rgba(120, 53, 15, 0.35), transparent 60%),
         linear-gradient(160deg, #292524 0%, #0c0a09 100%);"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-stone-950/40 via-transparent to-stone-950/70"></div>

  <div class="relative mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:py-20">
    <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
      <%= t("home.hero.title_lead") %>
      <span class="text-brand-400"><%= t("home.hero.title_highlight") %></span>
      <%= t("home.hero.title_tail") %>
    </h1>

    <p class="mx-auto mt-4 max-w-2xl text-sm text-stone-300 sm:text-base">
      <%= t("home.hero.subtitle") %>
    </p>

    <%# Busca de verdade: cai em /anuncios com os mesmos parâmetros que o painel
        de filtros da listagem usa. %>
    <%= form_with url: ads_path, method: :get, class: "mx-auto mt-8 max-w-3xl" do %>
      <div class="flex flex-col gap-2 rounded-2xl bg-white p-2 shadow-xl shadow-stone-950/30 sm:flex-row sm:items-center sm:rounded-full">
        <div class="flex items-center gap-2 border-stone-200 px-3 sm:w-52 sm:shrink-0 sm:border-r">
          <svg class="h-4 w-4 shrink-0 text-stone-400" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
          <%= label_tag :category, t("home.hero.search.category_label"), class: "sr-only" %>
          <%= select_tag :category,
                options_for_select([ [ t("home.hero.search.all_categories"), "" ] ] + home_category_options),
                class: "w-full cursor-pointer appearance-none bg-transparent py-2.5 text-sm font-semibold text-stone-700 focus:outline-none" %>
        </div>

        <%= label_tag :q, t("home.hero.search.label"), class: "sr-only" %>
        <%= search_field_tag :q, nil, placeholder: t("home.hero.search.placeholder"), autocomplete: "off",
              class: "min-w-0 flex-1 bg-transparent px-3 py-2.5 text-sm text-stone-800 placeholder:text-stone-400 focus:outline-none" %>

        <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-bold text-stone-950 transition hover:bg-brand-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <%= t("home.hero.search.submit") %>
        </button>
      </div>
    <% end %>

    <%# Atalhos: veículos em cima, peças embaixo — cada um é uma busca real. %>
    <div class="mt-6 space-y-2" aria-label="<%= t('home.hero.quick_label') %>">
      <% HomeController::QUICK_SEARCHES.each do |group, terms| %>
        <div class="flex flex-wrap justify-center gap-2">
          <% terms.each do |term| %>
            <%= link_to term, ads_path(q: term), class: quick_search_class(group) %>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="mt-8 text-sm font-bold text-white">
      <%= t("home.hero.tagline") %>
    </p>
  </div>
</section>

<%# --------------------------------------------------- 1. Anúncios Recentes %>
<section class="bg-stone-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <%= render "home/section_heading", title: t("home.ads.title"), subtitle: t("home.ads.subtitle"),
          icon: :clock, link_path: ads_path, link_label: t("home.ads.see_all") %>

    <% if @ads.any? %>
      <%# Duas fileiras de seis, de propósito: uma grade única de doze quebraria
          em qualquer múltiplo conforme a largura, e a home foi desenhada com a
          divisão visível. %>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        <%= render partial: "home/ad_card", collection: @ads.first(HomeController::RECENT_ROW), as: :ad %>
      </div>

      <% if @ads.size > HomeController::RECENT_ROW %>
        <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
          <%= render partial: "home/ad_card", collection: @ads.drop(HomeController::RECENT_ROW), as: :ad %>
        </div>
      <% end %>
    <% else %>
      <p class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">
        <%= t("home.ads.empty") %>
      </p>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------- 2. Galeria de fotos %>
<%= render "home/photo_gallery", images: @gallery_top,
      title: t("home.gallery.title"), subtitle: t("home.gallery.subtitle") %>

<%# ------------------------------------------------------------ 3. Mais Vistos %>
<section class="border-t border-stone-200 bg-stone-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <%= render "home/section_heading", title: t("home.most_viewed.title"),
          subtitle: t("home.most_viewed.subtitle"), icon: :eye,
          link_path: ads_path, link_label: t("home.most_viewed.see_all") %>

    <% if @most_viewed.any? %>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        <%= render partial: "home/ad_card", collection: @most_viewed, as: :ad, locals: { show_views: true } %>
      </div>
    <% else %>
      <p class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-10 text-center text-sm text-stone-500">
        <%= t("home.most_viewed.empty") %>
      </p>
    <% end %>
  </div>
</section>

<%# -------------------------------------------------------- 4. Próximos Eventos %>
<section class="border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <%= render "home/section_heading", title: t("home.events.title"),
          subtitle: t("home.events.subtitle"), icon: :calendar %>

    <% if @events.any? %>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <%= render partial: "home/event_card", collection: @events, as: :event %>
      </div>
    <% else %>
      <p class="mt-6 rounded-2xl border border-dashed border-stone-300 px-6 py-10 text-center text-sm text-stone-500">
        <%= t("home.events.empty") %>
      </p>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------- 5. Newsletter %>
<%= render "home/newsletter" %>

<%# --------------------------------------------------- 6. Galeria de fotos (fim) %>
<%= render "home/photo_gallery", images: @gallery_bottom,
      title: t("home.gallery.more_title"), subtitle: t("home.gallery.more_subtitle") %>
