<%# Home. O Header e o Footer ficam no layout (app/views/layouts/application.html.erb). %>

<%# ---------------------------------------------------------------- Hero %>
<section class="relative overflow-hidden border-b border-stone-800 bg-stone-900">
  <!-- Espaço para a imagem temática: troque o gradiente abaixo por image_tag "hero-trilha.jpg", class: "absolute inset-0 h-full w-full object-cover" -->
  <div class="absolute inset-0"
       style="background-image:
         radial-gradient(circle at 15% 20%, rgba(249, 128, 7, 0.28), transparent 55%),
         radial-gradient(circle at 85% 10%, rgba(183, 60, 6, 0.22), transparent 50%),
         linear-gradient(160deg, #1c1917 0%, #0c0a09 100%);"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-brand-500/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-300">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        <%= t("home.hero.badge") %>
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        <%= t("home.hero.title_lead") %>
        <span class="text-brand-400"><%= t("home.hero.title_highlight") %></span>
      </h1>

      <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-300 sm:text-lg">
        <%= t("home.hero.subtitle") %>
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-stone-950 shadow-lg shadow-brand-900/40 transition hover:bg-brand-400">
          <%= t("home.hero.cta_primary") %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <%= link_to t("home.hero.cta_secondary"), ads_path,
              class: "inline-flex items-center justify-center rounded-full border border-stone-600 px-7 py-3.5 text-sm font-bold uppercase tracking-wide text-stone-200 transition hover:border-brand-500 hover:text-brand-300" %>
      </div>

      <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-stone-700/60 pt-8">
        <div>
          <dt class="text-2xl font-extrabold text-white sm:text-3xl"><%= number_with_delimiter(5_600) %>+</dt>
          <dd class="mt-1 text-xs uppercase tracking-wide text-stone-400"><%= t("home.hero.stats.ads") %></dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-white sm:text-3xl"><%= number_with_delimiter(1_240) %></dt>
          <dd class="mt-1 text-xs uppercase tracking-wide text-stone-400"><%= t("home.hero.stats.sellers") %></dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-white sm:text-3xl">27</dt>
          <dd class="mt-1 text-xs uppercase tracking-wide text-stone-400"><%= t("home.hero.stats.states") %></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<%# -------------------------------------------------------- Categorias %>
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
  <div class="max-w-2xl">
    <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl"><%= t("home.categories.title") %></h2>
    <p class="mt-2 text-sm text-stone-400"><%= t("home.categories.subtitle") %></p>
  </div>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @categories.each do |category| %>
      <% count = @ad_counts.fetch(category.id, 0) %>
      <%= link_to ads_path(category: category.slug), class: "group relative flex flex-col overflow-hidden rounded-2xl border border-stone-800 bg-stone-900 p-7 transition hover:-translate-y-1 hover:border-brand-500/60 hover:bg-stone-800/60" do %>
        <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400 ring-1 ring-brand-500/25 transition group-hover:bg-brand-500 group-hover:text-stone-950">
          <%= category_icon_for(category.slug, css_class: "h-7 w-7") %>
        </span>

        <h3 class="mt-6 text-lg font-bold text-white"><%= category.name %></h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-400"><%= category.description %></p>

        <div class="mt-6 flex items-center justify-between border-t border-stone-800 pt-4">
          <span class="text-xs font-semibold uppercase tracking-wide text-stone-500">
            <%= t("home.categories.count", count: count, formatted: number_with_delimiter(count)) %>
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-brand-400">
            <%= t("home.categories.see_all") %>
            <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<%# --------------------------------------------------- Anúncios Recentes %>
<section class="border-t border-stone-800 bg-stone-900/40">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl"><%= t("home.ads.title") %></h2>
        <p class="mt-2 text-sm text-stone-400"><%= t("home.ads.subtitle") %></p>
      </div>
      <%= link_to ads_path, class: "inline-flex items-center gap-1.5 rounded-full border border-stone-700 px-5 py-2.5 text-xs font-bold uppercase tracking-wide text-stone-200 transition hover:border-brand-500 hover:text-brand-300" do %>
        <%= t("home.ads.see_all") %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <%= render partial: "ads/card", collection: @ads, as: :ad %>
    </div>
  </div>
</section>
