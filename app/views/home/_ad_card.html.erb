<%# Card compacto da régua da home. Claro e estreito — a listagem tem o seu
    próprio card, maior e escuro, em ads/_card. %>
<article class="group relative flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white transition hover:-translate-y-1 hover:border-brand-400 hover:shadow-lg hover:shadow-stone-900/10">
  <div class="relative aspect-[4/3] overflow-hidden bg-stone-100">
    <% cover = ad.cover_image %>
    <% if cover.present? %>
      <%= image_tag cover.url, alt: ad.title, loading: "lazy",
            class: "h-full w-full object-cover transition duration-300 group-hover:scale-105" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center">
        <svg class="h-8 w-8 text-stone-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
        </svg>
      </div>
    <% end %>

    <%# Uma etiqueta só: neste tamanho duas se atropelam. O destaque tem
        precedência sobre a categoria, que é o que ele existe para fazer. %>
    <% if ad.badge.present? %>
      <span class="absolute left-2 top-2 rounded-md bg-brand-500 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-stone-950">
        <%= t("home.ads.badges.#{ad.badge}") %>
      </span>
    <% else %>
      <span class="absolute left-2 top-2 rounded-md bg-stone-900/80 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white backdrop-blur">
        <%= ad.category.name %>
      </span>
    <% end %>

    <%# Só a régua "Mais Vistos" liga isto: nas outras o número não diz nada
        sobre o anúncio e só disputaria espaço com a etiqueta. %>
    <% if local_assigns[:show_views] && ad.views_count.positive? %>
      <span class="absolute bottom-2 right-2 flex items-center gap-1 rounded-md bg-stone-900/80 px-2 py-0.5 text-[10px] font-bold text-white backdrop-blur">
        <%= home_section_icon(:eye, css_class: "h-3 w-3") %>
        <%= number_with_delimiter(ad.views_count) %>
        <span class="sr-only"><%= t("home.most_viewed.views", count: ad.views_count) %></span>
      </span>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-3">
    <h3 class="line-clamp-2 text-xs font-semibold leading-snug text-stone-800 transition group-hover:text-brand-600">
      <%# after:inset-0 estende a área clicável para o card inteiro sem repetir o link. %>
      <%= link_to ad.title, ad_path(ad), class: "after:absolute after:inset-0" %>
    </h3>

    <p class="mt-1.5 text-sm font-extrabold tracking-tight text-brand-600">
      <%= ad_price(ad.price) %>
    </p>

    <p class="mt-auto flex items-center gap-1 pt-2 text-[11px] text-stone-500">
      <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
      <span class="truncate"><%= ad.city %>, <%= ad.state %></span>
    </p>
  </div>
</article>
