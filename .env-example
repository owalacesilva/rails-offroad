# Copie para .env antes de subir o ambiente:
#
#   cp .env-example .env
#
# O Docker Compose lê o .env automaticamente e interpola estas variáveis no
# compose.yaml. Todas têm default no compose, então o ambiente sobe mesmo sem .env.
#
# Aqui ficam só credenciais e portas do host. Os endereços internos
# (DB_HOST=db, MINIO_ENDPOINT=http://minio:9000, SMTP_ADDRESS=mailhog) são fixados
# no compose.yaml de propósito: dentro da rede do Compose valem os nomes dos
# serviços, enquanto no host valeria localhost. Colocá-los aqui quebraria um dos dois.

# ---------------------------------------------------------------- Aplicação
WEB_PORT=3000
RAILS_MAX_THREADS=5

# ---------------------------------------------------------------- MySQL
# A aplicação conecta como root: é ela quem cria os bancos de development e test.
MYSQL_ROOT_PASSWORD=root
DB_PORT=3306

# ---------------------------------------------------------------- phpMyAdmin
# Entra direto, sem tela de login, em http://localhost:5050
PHPMYADMIN_PORT=5050

# ---------------------------------------------------------------- MinIO
# API em http://localhost:9000 e console web em http://localhost:9001
# Atenção: MINIO_ROOT_PASSWORD precisa ter no mínimo 8 caracteres.
MINIO_ROOT_USER=offroad
MINIO_ROOT_PASSWORD=offroad123
MINIO_BUCKET=offroad-classifieds-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------- MailHog
# Caixa de entrada de desenvolvimento em http://localhost:8025
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ---------------------------------------------------------------- Redes sociais
# Endereços exibidos no rodapé (ver lib/social_links.rb). Não são segredo: ficam
# aqui porque mudam por instalação, não porque precisem ser escondidos.
#
# Variável vazia ou ausente some do rodapé em vez de virar um link para "#" —
# uma instalação sem canal no YouTube simplesmente não mostra o ícone. Por isso
# os valores abaixo vêm comentados: descomente e troque pelos endereços reais.
# SOCIAL_INSTAGRAM_URL=https://instagram.com/suaconta
# SOCIAL_YOUTUBE_URL=https://youtube.com/@seucanal
# SOCIAL_FACEBOOK_URL=https://facebook.com/suapagina
# SOCIAL_WHATSAPP_URL=https://wa.me/5541900000000

# ------------------------------------------------- Entrar com Google/Facebook
# Credenciais do cliente OAuth de cada provedor (ver lib/oauth_provider.rb).
# Estas são segredo de verdade, ao contrário dos links acima.
#
# O par precisa estar completo: provedor com só o ID definido continua sem
# botão no login, porque sem o secret o portal não consegue trocar o código de
# autorização por um token. Nenhum dos dois configurado é o padrão, e aí a
# página de entrar mostra apenas e-mail e senha.
#
# A URL de retorno a cadastrar no console de cada provedor é
#   http://localhost:3000/entrar/google/retorno
#   http://localhost:3000/entrar/facebook/retorno
#
# Google:   https://console.cloud.google.com/apis/credentials  (OAuth client ID)
# Facebook: https://developers.facebook.com/apps  (produto "Facebook Login")
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ------------------------------------------------- Pagamento do plano Premium
# Credencial do PagBank/PagSeguro (ver lib/pagseguro.rb). Sem PAGSEGURO_TOKEN a
# assinatura não existe: /anunciante/premium devolve 404, o item Premium não
# aparece no menu do painel e o botão do plano Premium em /planos volta a ser o
# e-mail de contato. Uma instalação que só quer classificado de graça fica
# exatamente como estava.
#
# O token é o da conta, criado em Vendas > Integrações > Token de segurança
# (sandbox: https://sandbox.pagbank.uol.com.br). É segredo de verdade.
#
# PAGSEGURO_ENV aceita "sandbox" ou "production", e o padrão é sandbox — de
# propósito: esquecer a variável tem de custar uma cobrança que não acontece,
# nunca uma que acontece sem querer. Qualquer outro valor também cai em sandbox.
#
# A URL de notificação é registrada pelo próprio portal em cada cobrança, então
# não há nada a cadastrar no painel — mas ela precisa ser alcançável pela
# internet para o pagamento ser confirmado. Em desenvolvimento, localhost não é:
# use um túnel (cloudflared, ngrok) e acesse o portal por esse endereço.
# PAGSEGURO_TOKEN=
# PAGSEGURO_ENV=sandbox
